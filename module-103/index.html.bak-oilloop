  var OBJ340={"equipment": {"title": "Main Equipment · Unit 340 (18 records · train 1 only)", "cols": ["Tag", "Service", "Skid", "Driver / motor"], "rows": [["C-341-1", "Ammonia compressor 1 · GEA VR-V307-28 · 2950 rpm · swept 1775.50 m3/h · Vi 3 · casing 28 barg, -40/120 °C, cast iron", "PK-341-1", "MC-341-1"], ["C-341-2", "Ammonia compressor 2 · GEA VR-V307-28 · 2950 rpm · swept 1775.50 m3/h · Vi 3", "PK-341-2", "MC-341-2"], ["C-341-3", "Ammonia compressor 3 · GEA VR-V307-28 · 2950 rpm · swept 1775.50 m3/h · Vi 3", "PK-341-3", "MC-341-3"], ["C-341-4", "Ammonia compressor 4 · GEA VR-V307-28 · 2950 rpm · swept 1775.50 m3/h · Vi 3", "PK-341-4", "MC-341-4"], ["V-341-1", "Oil separator · FV/28 barg · -15/120 °C · ID 700 mm · TL-TL 4600 mm · LTCS · 2.12 m3 · coalescers", "PK-341-1", "—"], ["E-341-1", "Oil cooler · duty 338 kW · 28 barg · -15/120 °C · CS or Cu/Al fin · Fan Quantity HOLD · Fan Rated Power HOLD kW", "PK-341-1", "MF-341-1-1…10"], ["F-341-1A/B", "Main oil filter · 34 barg · -15/120 °C · ID 600 mm · 0.13 m3 · particulate filter SM 50", "PK-341-1", "—"], ["F-341-1…8", "Fan (rolled-up equipment record) · absorbed power 3 kW · speed and capacity HOLD", "PK-341-1", "MF-341-1-1…10"], ["P-341-1", "Oil pump · KRACHT KF100 volumetric · 1450 rpm · 135 l/min · casing 34 barg, -15/120 °C, CS · Motor Power 4 kW", "PK-341-1", "MP-341-1"], ["X-341-1A/B/C", "Oil heater · rated power 3 × 1.725 kW (= 5.175 kW) · supply 690 Vac / 50 Hz / 3 Ph", "PK-341-1", "—"], ["V-343", "Ammonia receiver · FV/28 barg · -45/120 °C · ID 800 mm · TL-TL 5000 mm · LTCS · 2.5 m3", "340 (common)", "—"], ["E-342-1", "Ammonia condenser · duty 5116 kW · FV/28 barg · -45/120 °C · 304 tube / Al fin · Fan Quantity 18 each · Fan Rated Power 4 kW · surface area HOLD", "340 (common)", "MF-342-1-1…12"], ["E-342-2", "Ammonia condenser · duty 5116 kW · FV/28 barg · -45/120 °C · 304 tube / Al fin · Fan Quantity 18 each · Fan Rated Power 4 kW · surface area HOLD", "340 (common)", "MF-342-2-1…12"], ["E-342-3", "Ammonia condenser · duty 5116 kW · FV/28 barg · -45/120 °C · 304 tube / Al fin · Fan Quantity 18 each · Fan Rated Power 4 kW · surface area HOLD", "340 (common)", "MF-342-3-1…12"], ["E-342-4", "Ammonia condenser · duty 5116 kW · FV/28 barg · -45/120 °C · 304 tube / Al fin · Fan Quantity 18 each · Fan Rated Power 4 kW · surface area HOLD", "340 (common)", "MF-342-4-1…12"], ["E-342-5", "Ammonia condenser · duty 5116 kW · FV/28 barg · -45/120 °C · 304 tube / Al fin · Fan Quantity 18 each · Fan Rated Power 4 kW · surface area HOLD", "340 (common)", "MF-342-5-1…12"], ["E-342-6", "Ammonia condenser · duty 5116 kW · FV/28 barg · -45/120 °C · 304 tube / Al fin · Fan Quantity 18 each · Fan Rated Power 4 kW · surface area HOLD", "340 (common)", "MF-342-6-1…12"], ["F-342-1…6/1…18", "Fan (rolled-up equipment record) · absorbed power 3 kW · speed and capacity HOLD", "340 (common)", "MF-342-x-1…12"]], "foot": "Printed from plant_equipment, 18 records. ONLY TRAIN 1 IS DIGITISED AT EQUIPMENT LEVEL (DB-FACTS 2.1): the four compressors C-341-1…4 exist, but plant_equipment and plant_assets hold NO records for E-341-2/3/4, V-341-2/3/4, F-341-2A/B…4A/B, P-341-2/3/4 or X-341-2/3/4, even though plant_instruments, plant_electrical_loads and plant_mcc_motors carry all four trains. Any four-identical-trains graphic is inference, not register. Two records also carry rolled-up fan tags (F-341-1…8 and F-342-1…6/1…18) that contradict the individual asset tags F-341-x-1…10 and F-342-x-1…12. Disagreements printed as the database holds them: E-342 notes read Fan Quantity 18 each while the asset register, the MCC schedule and the load list all say 12 (the manual also says 12, the P&ID PR38 rev 8 says 18); E-341-1 notes still read HOLD; V-341-1 internal diameter is 700 mm in plant_equipment and 762 mm in the PR34 drawing notes; the compressor model is VR-V307-28 in plant_equipment and VR-V30T-28 on the drawings. plant_mechanical_assets carries 89 rows for the unit but every dimensional and design field is null, and it mis-types C-341-1…4 and P-341-1 as electric motors."}, "valves": {"title": "Instrumented valves · Unit 340 (38)", "cols": ["Tag", "Service", "Type", "Set pressure (DB)", "Line / P&ID", "Where the set pressure comes from"], "rows": [["PCV-3401", "Ammonia loop pressure control", "Inlet pressure control valve, self-contained", "—", "8\"-AN-340004-3C1 · PR38", "DB blank: notes field reads Set pressure with no number. P&ID PR38 shows 25.45 barg, not in the DB"], ["PCV-3402", "Ammonia loop pressure control", "Outlet pressure regulator, self-contained", "—", "1½\"-AN-340006-3L1 · PR38", "Recorded in plant_instruments, not plant_valves. DB range empty. P&ID PR38 shows 24.7 barg, not in the DB"], ["PEV-3401", "Pilot solenoid on PCV-3401", "Solenoid valve", "—", "PR38 (per the register)", "DANFOSS 018Z6596 · DO 24 VDC · JB P-PN-OV351.1 · but NOT drawn on PR38 rev 8 and no I/O channel — see the footnote"], ["PEV-3402", "Pilot solenoid on PCV-3402", "Solenoid valve", "—", "PR38", "DANFOSS 018Z6596 · DO 24 VDC · JB P-PN-OV351.1"], ["PSV-3401A", "V-343 pressure relief", "Pressure safety valve", "28 barg", "PR38", "DB numeric field (plant_valve_assets.inst_range_raw = 28) · agrees with the P&ID"], ["PSV-3401B", "V-343 pressure relief", "Pressure safety valve", "28 barg", "PR38", "DB numeric field (plant_valve_assets.inst_range_raw = 28) · agrees with the P&ID"], ["PSV-3411.1", "C-341-1 blocked outlet relief", "Pressure safety valve", "28 barg", "PR34", "DB free text only (plant_valves.notes) · structured field null · P&ID PR34-37 agrees"], ["PSV-3411.2", "C-341-2 blocked outlet relief", "Pressure safety valve", "28 barg", "PR35", "DB free text only (plant_valves.notes) · structured field null · P&ID PR34-37 agrees"], ["PSV-3411.3", "C-341-3 blocked outlet relief", "Pressure safety valve", "28 barg", "PR36", "DB free text only (plant_valves.notes) · structured field null · P&ID PR34-37 agrees"], ["PSV-3411.4", "C-341-4 blocked outlet relief", "Pressure safety valve", "28 barg", "PR37", "DB free text only (plant_valves.notes) · structured field null · P&ID PR34-37 agrees"], ["PSV-3417.1A", "V-341-1 pressure relief", "Pressure safety valve", "28 barg", "1\"-FL-341122-3C1 · PR34", "DB free text only (plant_valves.notes) · structured field null · P&ID PR34-37 agrees, DRY FIRE change-over pair"], ["PSV-3417.1B", "V-341-1 pressure relief", "Pressure safety valve", "28 barg", "1\"-FL-341122-3C1 · PR34", "DB free text only (plant_valves.notes) · structured field null · P&ID PR34-37 agrees, DRY FIRE change-over pair"], ["PSV-3417.2A", "V-341-2 pressure relief", "Pressure safety valve", "28 barg", "1\"-FL-341222-3C1 · PR35", "DB free text only (plant_valves.notes) · structured field null · P&ID PR34-37 agrees, DRY FIRE change-over pair"], ["PSV-3417.2B", "V-341-2 pressure relief", "Pressure safety valve", "28 barg", "1\"-FL-341222-3C1 · PR35", "DB free text only (plant_valves.notes) · structured field null · P&ID PR34-37 agrees, DRY FIRE change-over pair"], ["PSV-3417.3A", "V-341-3 pressure relief", "Pressure safety valve", "28 barg", "1\"-FL-341322-3C1 · PR36", "DB free text only (plant_valves.notes) · structured field null · P&ID PR34-37 agrees, DRY FIRE change-over pair"], ["PSV-3417.3B", "V-341-3 pressure relief", "Pressure safety valve", "28 barg", "1\"-FL-341322-3C1 · PR36", "DB free text only (plant_valves.notes) · structured field null · P&ID PR34-37 agrees, DRY FIRE change-over pair"], ["PSV-3417.4A", "V-341-4 pressure relief", "Pressure safety valve", "28 barg", "1\"-FL-341422-3C1 · PR37", "DB free text only (plant_valves.notes) · structured field null · P&ID PR34-37 agrees, DRY FIRE change-over pair"], ["PSV-3417.4B", "V-341-4 pressure relief", "Pressure safety valve", "28 barg", "1\"-FL-341422-3C1 · PR37", "DB free text only (plant_valves.notes) · structured field null · P&ID PR34-37 agrees, DRY FIRE change-over pair"], ["PSV-3418.1", "P-341-1 pressure relief", "Pressure safety valve", "6 bar diff.", "PR34", "DB free text 