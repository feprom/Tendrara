7" stroke-width="1.15" stroke-linecap="round" stroke-linejoin="round" stroke-dasharray="4 3"/><g transform="translate(517.0,80)"><circle cx="-4" cy="0" r="1.9" fill="#fff" stroke="#4A4F57" stroke-width="1.15"/><circle cx="4" cy="0" r="1.9" fill="#fff" stroke="#4A4F57" stroke-width="1.15"/></g><path d="M-4.5,-3 L1,0 L-4.5,3 Z" fill="#4A4F57" transform="translate(548,80)"/><g><title>C-341-x SLIDE</title><rect x="562" y="68" width="88" height="24" rx="4" fill="#fff" stroke="#D6DAE0" stroke-width="1.3"/><text x="606" y="84" text-anchor="middle" font-family="Consolas,monospace" font-size="6.6" font-weight="700" fill="#4A4F57">C-341-x SLIDE</text></g><text x="18" y="150" font-family="Consolas,monospace" font-size="7.6" font-weight="700" fill="#C8102E">LIC-3111</text><text x="18" y="160" font-family="Consolas,monospace" font-size="6.4" fill="#4A4F57">E-311 ammonia level</text><text x="18" y="169" font-family="Consolas,monospace" font-size="6.2" fill="#8B939C">0..100 % &#183; normal 35 %</text><g transform="translate(40,190)"><title>LT-3111 &#183; PCS</title><circle cx="0" cy="0" r="11" fill="#fff" stroke="#15171A" stroke-width="1.3" stroke-linecap="round"/><text x="0" y="-2.2" text-anchor="middle" font-family="Consolas,monospace" font-size="7.4" font-weight="700" fill="#15171A">LT</text><text x="0" y="6.4" text-anchor="middle" font-family="Consolas,monospace" font-size="6.6" font-weight="400" fill="#15171A">3111</text></g><path d="M 52,190 L 136,190" fill="none" stroke="#4A4F57" stroke-width="1.15" stroke-linecap="round" stroke-linejoin="round"/><path d="M-4.5,-3 L1,0 L-4.5,3 Z" fill="#4A4F57" transform="translate(136,190)"/><g transform="translate(150,190)"><title>LIC-3111 &#183; PCS controller</title><rect x="-11" y="-11" width="22" height="22" fill="#fff" stroke="#15171A" stroke-width="1.3" stroke-linecap="round"/><circle cx="0" cy="0" r="10.6" fill="none" stroke="#15171A" stroke-width="1.3" stroke-linecap="round"/><line x1="-11" y1="0" x2="11" y2="0" stroke="#15171A" stroke-width="1.3" stroke-linecap="round"/><text x="0" y="-2.2" text-anchor="middle" font-family="Consolas,monospace" font-size="7.4" font-weight="700" fill="#15171A">LIC</text><text x="0" y="6.4" text-anchor="middle" font-family="Consolas,monospace" font-size="6.6" font-weight="400" fill="#15171A">3111</text></g><path d="M 164,190 L 226,190" fill="none" stroke="#4A4F57" stroke-width="1.15" stroke-linecap="round" stroke-linejoin="round" stroke-dasharray="5 3"/><path d="M-4.5,-3 L1,0 L-4.5,3 Z" fill="#4A4F57" transform="translate(226,190)"/><g class="vlv" data-vtag="LV-3111" data-vkind="CONTROL_VALVE" transform="translate(260,190)"><title>LV-3111</title><path d="M -9,-6.5 L -9,6.5 L 0,0 Z" fill="#fff" stroke="#333" stroke-width="1.4" stroke-linecap="round"/><path d="M 9,-6.5 L 9,6.5 L 0,0 Z" fill="#fff" stroke="#333" stroke-width="1.4" stroke-linecap="round"/><line x1="0" y1="0" x2="0" y2="-13" stroke="#333" stroke-width="1.4" stroke-linecap="round"/><path d="M -7,-13 A 7,5.5 0 0 1 7,-13 Z" fill="#fff" stroke="#333" stroke-width="1.4" stroke-linecap="round"/></g><text x="260" y="216" text-anchor="middle" font-family="Consolas,monospace" font-size="6.6" font-weight="700" fill="#4A4F57">LV-3111</text><text x="340" y="150" font-family="Consolas,monospace" font-size="7.6" font-weight="700" fill="#C8102E">LIC-3540</text><text x="340" y="160" font-family="Consolas,monospace" font-size="6.4" fill="#4A4F57">E-354 ammonia level</text><text x="340" y="169" font-family="Consolas,monospace" font-size="6.2" fill="#8B939C">0..100 % &#183; normal 90 %</text><g transform="translate(362,190)"><title>LT-3540 &#183; PCS</title><circle cx="0" cy="0" r="11" fill="#fff" stroke="#15171A" stroke-width="1.3" stroke-linecap="round"/><text x="0" y="-2.2" text-anchor="middle" font-family="Consolas,monospace" font-size="7.4" font-weight="700" fill="#15171A">LT</text><text x="0" y="6.4" text-anchor="middle" font-family="Consolas,monospace" font-size="6.6" font-weight="400" fill="#15171A">3540</text></g><path d="M 374,190 L 458,190" fill="none" stroke="#4A4F57" stroke-width="1.15" stroke-linecap="round" stroke-linejoin="round"/><path d="M-4.5,-3 L1,0 L-4.5,3 Z" fill="#4A4F57" transform="translate(458,190)"/><g transform="translate(472,190)"><title>LIC-3540 &#183; PCS controller</title><rect x="-11" y="-11" width="22" height="22" fill="#fff" stroke="#15171A" stroke-width="1.3" stroke-linecap="round"/><circle cx="0" cy="0" r="10.6" fill="none" stroke="#15171A" stroke-width="1.3" stroke-linecap="round"/><line x1="-11" y1="0" x2="11" y2="0" stroke="#15171A" stroke-width="1.3" stroke-linecap="round"/><text x="0" y="-2.2" text-anchor="middle" font-family="Consolas,monospace" font-size="7.4" font-weight="700" fill="#15171A">LIC</text><text x="0" y="6.4" text-anchor="middle" font-family="Consolas,monospace" font-size="6.6" font-weight="400" fill="#15171A">3540</text></g><path d="M 486,190 L 548,190" fill="none" stroke="#4A4F57" stroke-width="1.15" stroke-linecap="round" stroke-linejoin="round" stroke-dasharray="5 3"/><path d="M-4.5,-3 L1,0 L-4.5,3 Z" fill="#4A4F57" transform="translate(548,190)"/><g class="vlv" data-vtag="LV-3540" data-vkind="CONTROL_VALVE" transform="translate(582,190)"><title>LV-3540</title><path d="M -9,-6.5 L -9,6.5 L 0,0 Z" fill="#fff" stroke="#333" stroke-width="1.4" stroke-linecap="round"/><path d="M 9,-6.5 L 9,6.5 L 0,0 Z" fill="#fff" stroke="#333" stroke-width="1.4" stroke-linecap="round"/><line x1="0" y1="0" x2="0" y2="-13" stroke="#333" stroke-width="1.4" stroke-linecap="round"/><path d="M -7,-13 A 7,5.5 0 0 1 7,-13 Z" fill="#fff" stroke="#333" stroke-width="1.4" stroke-linecap="round"/></g><text x="582" y="216" text-anchor="middle" font-family="Consolas,monospace" font-size="6.6" font-weight="700" fill="#4A4F57">LV-3540</text><text x="284" y="110" text-anchor="middle" font-family="Consolas,monospace" font-size="6.2" fill="#8B939C">on / off staging, NOT modulation</text><text x="606" y="110" text-anchor="middle" font-family="Consolas,monospace" font-size="6.2" fill="#8B939C">capacity of every RUNNING compressor</text><text x="606" y="119" text-anchor="middle" font-family="Consolas,monospace" font-size="6.2" font-weight="700" fill="#C8102E">which compressors run is a MANUAL choice</text><line x1="684" y1="28" x2="684" y2="252" stroke="#D6DAE0" stroke-width="1"/><text x="700" y="40" font-family="Consolas,monospace" font-size="7.2" font-weight="700" fill="#C8102E">CAPACITY CONTROL &#8212; how the slide valve actually moves</text><g transform="translate(728,86)"><title>PIC-3552 &#183; master</title><rect x="-11" y="-11" width="22" height="22" fill="#fff" stroke="#15171A" stroke-width="1.3" stroke-linecap="round"/><circle cx="0" cy="0" r="10.6" fill="none" stroke="#15171A" stroke-width="1.3" stroke-linecap="round"/><line x1="-11" y1="0" x2="11" y2="0" stroke="#15171A" stroke-width="1.3" stroke-linecap="round"/><text x="0" y="-2.2" text-anchor="middle" font-family="Consolas,monospace" font-size="7.4" font-weight="700" fill="#15171A">PIC</text><text x="0" y="6.4" text-anchor="middle" font-family="Consolas,monospace" font-size="6.6" font-weight="400" fill="#15171A">3552</text></g><path d="M 740,86 L 792,86" fill="none" stroke="#4A4F57" stroke-width="1.15" stroke-linecap="round" stroke-linejoin="round" stroke-dasharray="4 3"/><g transform="translate(766.0,86)"><circle cx="-4" cy="0" r="1.9" fill="#fff" stroke="#4A4F57" stroke-width="1.15"/><circle cx="4" cy="0" r="1.9" fill="#fff" stroke="#4A4F57" stroke-width="1.15"/></g><path d="M-4.5,-3 L1,0 L-4.5,3 Z" fill="#4A4F57" transform="translate(792,86)"/><g transform="translate(816,86)"><title>ZEV-3411.x / 3412.x / 3413.x / 3414.x per compressor</title><circle cx="0" cy="0" r="11" fill="#fff" stroke="#15171A" stroke-width="1.3" stroke-linecap="round"/><text x="0" y="-2.2" text-anchor="middle" font-family="Consolas,monospace" font-size="7.4" font-weight="700" fill="#15171A">ZEV</text><text x="0" y="6.4" text-anchor="middle" font-family="Consolas,monospace" font-size="6.6" font-weight="400" fill="#15171A">&#215;4</text></g><path d="M 828,86 L 876,86" fill="none" stroke="#4A4F57" stroke-width="1.15" stroke-linecap="round" stroke-linejoin="round" stroke-dasharray="5 3"/><path d="M-4.5,-3 L1,0 L-4.5,3 Z" fill="#4A4F57" transform="translate(876,86)"/><g><title>C-341-x slide valve</title><rect x="890" y="74" width="94" height="24" rx="4" fill="#fff" stroke="#D6DAE0" stroke-width="1.3"/><text x="937" y="90" text-anchor="middle" font-family="Consolas,monospace" font-size="6.6" font-weight="700" fill="#4A4F57">SLIDE VALVE</text></g><text x="728" y="110" text-anchor="middle" font-family="Consolas,monospace" font-size="6.0" fill="#8B939C">master</text><text x="816" y="110" text-anchor="middle" font-family="Consolas,monospace" font-size="6.0" fill="#8B939C">four solenoids</text><g transform="translate(816,190)"><title>ZT-3411.x &#183; position feedback</title><circle cx="0" cy="0" r="11" fill="#fff" stroke="#15171A" stroke-width="1.3" stroke-linecap="round"/><text x="0" y="-2.2" text-anchor="middle" font-family="Consolas,monospace" font-size="7.4" font-weight="700" fill="#15171A">ZT</text><text x="0" y="6.4" text-anchor="middle" font-family="Consolas,monospace" font-size="6.6" font-weight="400" fill="#15171A">3411.x</text></g><path d="M 937,98 L 937,190 L 828,190" fill="none" stroke="#8B939C" stroke-width="1.1" stroke-dasharray="4 3"/><text x="816" y="214" text-anchor="middle" font-family="Consolas,monospace" font-size="6.0" fill="#8B939C">position feedback</text><text x="700" y="232" font-family="Consolas,monospace" font-size="6.3" fill="#4A4F57">the start sequence will not release the motor until</text><text x="700" y="241" font-family="Consolas,monospace" font-size="6.3" font-weight="700" fill="#4A4F57">the feedback reads BELOW 5 %</text><text x="700" y="252" font-family="Consolas,monospace" font-size="6.3" fill="#8B939C">the oil that moves it is the SAME oil that lubricates</text><line x1="14" y1="278" x2="986" y2="278" stroke="#D6DAE0" stroke-width=".8"/><text x="0" y="291" font-family="Consolas,monospace" font-size="6.8" font-weight="700" fill="#C8102E">WHAT IS AND IS NOT A REGISTERED LOOP</text><text x="0" y="302" font-family="Consolas,monospace" font-size="6.3" fill="#4A4F57">The register holds ONE control loop inside Unit 340 &#8212; PIC-3401. LIC-3111 belongs to Unit 310, LIC-3540 and PIC-3552 to Unit 350; they are drawn here because they are the R1 cycle even though they are not the unit&#8217;s records.</text><text x="0" y="313" font-family="Consolas,monospace" font-size="6.3" fill="#4A4F57">PCV-3401 and PCV-3402 are SELF-CONTAINED regulators with a solenoid pilot, not PCS loops &#8212; there is no faceplate to tune, only a set pressure on the valve.</text><text x="0" y="324" font-family="Consolas,monospace" font-size="6.3" fill="#8B939C">PIC-3411.x and TIC-3417.1 are REAL &#8212; live faceplates on the compressor HMI &#8212; but the registry has no record of them. It is the DATABASE that is incomplete, not the control system.</text></svg>',
  };
  var LOC340_ANN={
    cycle:{h:378, g:'<g class="ann"><line x1="14" y1="352" x2="986" y2="352" stroke="#D6DAE0" stroke-width=".8"/><text x="14" y="366" font-family="Consolas,monospace" font-size="7.6" font-weight="700" fill="#C8102E">&#9312; COMPRESS</text><text x="266" y="366" font-family="Consolas,monospace" font-size="7.6" font-weight="700" fill="#C8102E">&#9313; CONDENSE</text><text x="518" y="366" font-family="Consolas,monospace" font-size="7.6" font-weight="700" fill="#C8102E">&#9314; COLLECT</text><text x="732" y="366" font-family="Consolas,monospace" font-size="7.6" font-weight="700" fill="#C8102E">&#9315; EXPAND &amp; EVAPORATE</text></g>'},
  };
  function LOC340(circuit,ann){
    var s=LOC340_SHEETS[circuit]||"", a=ann?LOC340_ANN[ann]:null;
    if(!s||!a) return s;
    return s.replace(/viewBox="0 0 1000 \d+"/,'viewBox="0 0 1000 '+a.h+'"')
            .replace("</svg>",a.g+"</svg>");
  }
  (function(){
    var locs=document.querySelectorAll(".loc[data-circuit]");
    for(var i=0;i<locs.length;i++){
      var d=locs[i];
      d.innerHTML=LOC340(d.getAttribute("data-circuit"),d.getAttribute("data-ann"));
      var hi=(d.getAttribute("data-hi")||"").trim();
      if(!hi) continue;
      var want=hi.split(/\s+/), gs=d.querySelectorAll("[data-eq]");
      for(var j=0;j<gs.length;j++){
        if(want.indexOf(gs[j].getAttribute("data-eq"))>=0) gs[j].classList.add("on");
      }
    }
  })();
</script>
<script>

(function(){
  document.querySelectorAll('.slide.m103scroll').forEach(function(sl){
    sl.addEventListener('scroll', function(){
      if (sl.scrollTop > 12) sl.classList.add('scrolled');
    }, {passive:true});
  });
})();

</script>
<script>

(function(){
  var band=document.getElementById('objtiles340'); if(!band) return;
  var host=band.closest ? band.closest('.slide') : null;
  if(host && host.className.indexOf('m103disc')<0) return;
  [].slice.call(band.querySelectorAll('.dsq')).forEach(function(sq){
    var svg=sq.querySelector('svg'); if(!svg) return;
    var t=svg.querySelectorAll('text');
    var title=(t[0]&&t[0].textContent)||'', n=(t[1]&&t[1].textContent)||'',
        unit=(t[2]&&t[2].textContent)||'ASSETS';
    // rects[0] is the card frame, rects[1] the 3.4 px discipline rule -- its
    // fill is the discipline colour, and the chip in the header reuses it
    var rects=svg.querySelectorAll('rect');
    var col=(rects[1]&&rects[1].getAttribute('fill'))||'#C8102E';
    var body=document.createElement('div'); body.className='dsqbody';
    while(sq.firstChild) body.appendChild(sq.firstChild);
    var hd=document.createElement('button');
    hd.type='button'; hd.className='dsqhd'; hd.setAttribute('aria-expanded','false');
    hd.title='Show the asset classes inside ' + title;
    hd.innerHTML='<span class="t"><i class="chip" style="background:'+col+'"></i>'+title+'</span>'
      +'<span class="c"><b class="n">'+n+'</b><span class="u">'+unit+'</span>'
      +'<span class="chev">&#9662;</span></span>';
    hd.addEventListener('click',function(){
      var open=!sq.classList.contains('open');
      sq.classList.toggle('open',open);
      hd.setAttribute('aria-expanded',open?'true':'false');
      hd.title=(open?'Hide':'Show')+' the asset classes inside '+title;
    });
    sq.appendChild(hd); sq.appendChild(body);
  });
})();

</script>
</body>
</html>