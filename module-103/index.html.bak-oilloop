="#333" stroke-width="1.4" stroke-linecap="round"/><line x1="0" y1="0" x2="0" y2="-13" stroke="#333" stroke-width="1.4" stroke-linecap="round"/><path d="M -7,-13 A 7,5.5 0 0 1 7,-13 Z" fill="#fff" stroke="#333" stroke-width="1.4" stroke-linecap="round"/></g><text x="787" y="152" text-anchor="middle" font-family="Consolas,monospace" font-size="6.9" font-weight="700" fill="#4A4F57">PCV-3101</text><text x="787" y="161" text-anchor="middle" font-family="Consolas,monospace" font-size="6.1" fill="#8B939C">E-311 back-pressure</text><g class="vlv" data-vtag="PCV-3111" data-vkind="CONTROL_VALVE" transform="translate(930,134)"><title>PCV-3111 &#8212; E-311 hot bypass</title><path d="M -9,-6.5 L -9,6.5 L 0,0 Z" fill="#fff" stroke="#333" stroke-width="1.4" stroke-linecap="round"/><path d="M 9,-6.5 L 9,6.5 L 0,0 Z" fill="#fff" stroke="#333" stroke-width="1.4" stroke-linecap="round"/><line x1="0" y1="0" x2="0" y2="-13" stroke="#333" stroke-width="1.4" stroke-linecap="round"/><path d="M -7,-13 A 7,5.5 0 0 1 7,-13 Z" fill="#fff" stroke="#333" stroke-width="1.4" stroke-linecap="round"/></g><text x="930" y="152" text-anchor="middle" font-family="Consolas,monospace" font-size="6.9" font-weight="700" fill="#4A4F57">PCV-3111</text><text x="930" y="161" text-anchor="middle" font-family="Consolas,monospace" font-size="6.1" fill="#8B939C">E-311 hot bypass</text><line x1="0" y1="180" x2="1000" y2="180" stroke="#D6DAE0" stroke-width="1"/><text x="0" y="190" font-family="Consolas,monospace" font-size="8" font-weight="700" fill="#333">SOLENOIDS &#183; 18 records &#183; the pilots that actually move things</text><text x="1000" y="190" text-anchor="end" font-family="Consolas,monospace" font-size="6.6" fill="#8B939C">white, not yellow &#8212; these are OPERATING valves &#183; yellow is reserved for the safety family</text><g class="vlv" data-vtag="ZEV-3411.x" data-vkind="ONOFF_VALVE" transform="translate(72,218)"><title>ZEV-3411.x &#8212; slide valve &#183; load</title><path d="M -9,-6.5 L -9,6.5 L 0,0 Z" fill="#fff" stroke="#333" stroke-width="1.4" stroke-linecap="round"/><path d="M 9,-6.5 L 9,6.5 L 0,0 Z" fill="#fff" stroke="#333" stroke-width="1.4" stroke-linecap="round"/><line x1="0" y1="0" x2="0" y2="-11" stroke="#333" stroke-width="1.4" stroke-linecap="round"/><rect x="-6" y="-18.5" width="12" height="7.5" fill="#fff" stroke="#333" stroke-width="1.4" stroke-linecap="round"/><line x1="-6" y1="-11" x2="6" y2="-18.5" stroke="#333" stroke-width="1.4" stroke-linecap="round"/></g><text x="72" y="236" text-anchor="middle" font-family="Consolas,monospace" font-size="6.9" font-weight="700" fill="#4A4F57">ZEV-3411.x</text><text x="72" y="245" text-anchor="middle" font-family="Consolas,monospace" font-size="6.1" fill="#8B939C">slide valve &#183; load</text><g class="vlv" data-vtag="ZEV-3412.x" data-vkind="ONOFF_VALVE" transform="translate(215,218)"><title>ZEV-3412.x &#8212; slide valve &#183; unload</title><path d="M -9,-6.5 L -9,6.5 L 0,0 Z" fill="#fff" stroke="#333" stroke-width="1.4" stroke-linecap="round"/><path d="M 9,-6.5 L 9,6.5 L 0,0 Z" fill="#fff" stroke="#333" stroke-width="1.4" stroke-linecap="round"/><line x1="0" y1="0" x2="0" y2="-11" stroke="#333" stroke-width="1.4" stroke-linecap="round"/><rect x="-6" y="-18.5" width="12" height="7.5" fill="#fff" stroke="#333" stroke-width="1.4" stroke-linecap="round"/><line x1="-6" y1="-11" x2="6" y2="-18.5" stroke="#333" stroke-width="1.4" stroke-linecap="round"/></g><text x="215" y="236" text-anchor="middle" font-family="Consolas,monospace" font-size="6.9" font-weight="700" fill="#4A4F57">ZEV-3412.x</text><text x="215" y="245" text-anchor="middle" font-family="Consolas,monospace" font-size="6.1" fill="#8B939C">slide valve &#183; unload</text><g class="vlv" data-vtag="ZEV-3413.x" data-vkind="ONOFF_VALVE" transform="translate(358,218)"><title>ZEV-3413.x &#8212; slide valve</title><path d="M -9,-6.5 L -9,6.5 L 0,0 Z" fill="#fff" stroke="#333" stroke-width="1.4" stroke-linecap="round"/><path d="M 9,-6.5 L 9,6.5 L 0,0 Z" fill="#fff" stroke="#333" stroke-width="1.4" stroke-linecap="round"/><line x1="0" y1="0" x2="0" y2="-11" stroke="#333" stroke-width="1.4" stroke-linecap="round"/><rect x="-6" y="-18.5" width="12" height="7.5" fill="#fff" stroke="#333" stroke-width="1.4" stroke-linecap="round"/><line x1="-6" y1="-11" x2="6" y2="-18.5" stroke="#333" stroke-width="1.4" stroke-linecap="round"/></g><text x="358" y="236" text-anchor="middle" font-family="Consolas,monospace" font-size="6.9" font-weight="700" fill="#4A4F57">ZEV-3413.x</text><text x="358" y="245" text-anchor="middle" font-family="Consolas,monospace" font-size="6.1" fill="#8B939C">slide valve</text><g class="vlv" data-vtag="ZEV-3414.x" data-vkind="ONOFF_VALVE" transform="translate(501,218)"><title>ZEV-3414.x &#8212; slide valve</title><path d="M -9,-6.5 L -9,6.5 L 0,0 Z" fill="#fff" stroke="#333" stroke-width="1.4" stroke-linecap="round"/><path d="M 9,-6.5 L 9,6.5 L 0,0 Z" fill="#fff" stroke="#333" stroke-width="1.4" stroke-linecap="round"/><line x1="0" y1="0" x2="0" y2="-11" stroke="#333" stroke-width="1.4" stroke-linecap="round"/><rect x="-6" y="-18.5" width="12" height="7.5" fill="#fff" stroke="#333" stroke-width="1.4" stroke-linecap="round"/><line x1="-6" y1="-11" x2="6" y2="-18.5" stroke="#333" stroke-width="1.4" stroke-linecap="round"/></g><text x="501" y="236" text-anchor="middle" font-family="Consolas,monospace" font-size="6.9" font-weight="700" fill="#4A4F57">ZEV-3414.x</text><text x="501" y="245" text-anchor="middle" font-family="Consolas,monospace" font-size="6.1" fill="#8B939C">slide valve</text><g class="vlv" data-vtag="PEV-3401" data-vkind="ONOFF_VALVE" transform="translate(644,218)"><title>PEV-3401 &#8212; register only &#183; not on PR38</title><path d="M -9,-6.5 L -9,6.5 L 0,0 Z" fill="#fff" stroke="#333" stroke-width="1.4" stroke-linecap="round"/><path d="M 9,-6.5 L 9,6.5 L 0,0 Z" fill="#fff" stroke="#333" stroke-width="1.4" stroke-linecap="round"/><line x1="0" y1="0" x2="0" y2="-11" stroke="#333" stroke-width="1.4" stroke-linecap="round"/><rect x="-6" y="-18.5" width="12" height="7.5" fill="#fff" stroke="#333" stroke-width="1.4" stroke-linecap="round"/><line x1="-6" y1="-11" x2="6" y2="-18.5" stroke="#333" stroke-width="1.4" stroke-linecap="round"/></g><text x="644" y="236" text-anchor="middle" font-family="Consolas,monospace" font-size="6.9" font-weight="700" fill="#4A4F57">PEV-3401</text><text x="644" y="245" text-anchor="middle" font-family="Consolas,monospace" font-size="6.1" fill="#8B939C">register only &#183; not on PR38</text><g class="vlv" data-vtag="PEV-3402" data-vkind="ONOFF_VALVE" transform="translate(787,218)"><title>PEV-3402 &#8212; pilot on PCV-3402</title><path d="M -9,-6.5 L -9,6.5 L 0,0 Z" fill="#fff" stroke="#333" stroke-width="1.4" stroke-linecap="round"/><path d="M 9,-6.5 L 9,6.5 L 0,0 Z" fill="#fff" stroke="#333" stroke-width="1.4" stroke-linecap="round"/><line x1="0" y1="0" x2="0" y2="-11" stroke="#333" stroke-width="1.4" stroke-linecap="round"/><rect x="-6" y="-18.5" width="12" height="7.5" fill="#fff" stroke="#333" stroke-width="1.4" stroke-linecap="round"/><line x1="-6" y1="-11" x2="6" y2="-18.5" stroke="#333" stroke-width="1.4" stroke-linecap="round"/></g><text x="787" y="236" text-anchor="middle" font-family="Consolas,monospace" font-size="6.9" font-weight="700" fill="#4A4F57">PEV-3402</text><text x="787" y="245" text-anchor="middle" font-family="Consolas,monospace" font-size="6.1" fill="#8B939C">pilot on PCV-3402</text><g class="vlv" data-vtag="PEV-3101" data-vkind="ONOFF_VALVE" transform="translate(930,218)"><title>PEV-3101 &#8212; pilot on PCV-3101</title><path d="M -9,-6.5 L -9,6.5 L 0,0 Z" fill="#fff" stroke="#333" stroke-width="1.4" stroke-linecap="round"/><path d="M 9,-6.5 L 9,6.5 L 0,0 Z" fill="#fff" stroke="#333" stroke-width="1.4" stroke-linecap="round"/><line x1="0" y1="0" x2="0" y2="-11" stroke="#333" stroke-width="1.4" stroke-linecap="round"/><rect x="-6" y="-18.5" width="12" height="7.5" fill="#fff" stroke="#333" stroke-width="1.4" stroke-linecap="round"/><line x1="-6" y1="-11" x2="6" y2="-18.5" stroke="#333" stroke-width="1.4" stroke-linecap="round"/></g><text x="930" y="236" text-anchor="middle" font-family="Consolas,monospace" font-size="6.9" font-weight="700" fill="#4A4F57">PEV-3101</text><text x="930" y="245" text-anchor="middle" font-family="Consolas,monospace" font-size="6.1" fill="#8B939C">pilot on PCV-3101</text><text x="0" y="274" font-family="Consolas,monospace" font-size="6.2" fill="#8B939C">ZEV-3411.x&#8230;3414.x are DANFOSS BZ240C (P/N 018F4704), 230 VAC, four per compressor &#8212; they are what positions the slide valve, so a solenoid fault is a CAPACITY fault, not an alarm to ignore.</text><text x="0" y="284" font-family="Consolas,monospace" font-size="6.2" fill="#8B939C">MANUAL VALVES: the 340-HV / 340-HR series is on the P&amp;IDs but is NOT digitised &#8212; `plant_manual_valves` holds zero rows for this area. Do not quote a count.</text><text x="0" y="294" font-family="Consolas,monospace" font-size="6.2" font-weight="700" fill="#4A4F57">The unit has NO shutdown valve (no SDV) and NO blowdown valve (no BDV). It is protected by TRIPPING THE MACHINES and by the relief valves &#8212; there is nothing to slam shut.</text></svg>',
    instr340: '<svg viewBox="0 0 1000 320" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:auto;display:block;"><line x1="14" y1="150" x2="42" y2="150" stroke="#00A0B0" stroke-width="2.6"/><line x1="98" y1="150" x2="178" y2="150" stroke="#D1410C" stroke-width="2.6"/><line x1="234" y1="150" x2="318" y2="150" stroke="#7A5C00" stroke-width="2.6"/><line x1="334" y1="150" x2="458" y2="150" stroke="#D1410C" stroke-width="2.6"/><line x1="500" y1="150" x2="610" y2="150" stroke="#1F8A4C" stroke-width="2.6"/><line x1="676" y1="150" x2="742" y2="150" stroke="#1F8A4C" stroke-width="2.6"/><line x1="798" y1="150" x2="882" y2="150" stroke="#0B5CAD" stroke-width="2.6"/><line x1="938" y1="150" x2="986" y2="150" stroke="#00A0B0" stroke-width="2.6"/><text x="2" y="143" font-family="Consolas,monospace" font-size="6.2" fill="#8B939C">SUCTION</text><g><title>C-341-x</title><rect x="48" y="130" width="96" height="40" rx="4" fill="#fff" stroke="#D6DAE0" stroke-width="1.4"/><text x="96.0" y="155.0" text-anchor="middle" font-family="Segoe UI,Arial" font-size="12.5" font-weight="700" fill="#7f858c">C-341-x</text></g><g><title>V-341-x</title><rect x="188" y="130" width="96" height="40" rx="4" fill="#fff" stroke="#D6DAE0" stroke-width="1.4"/><text x="236.0" y="155.0" text-anchor="middle" font-family="Segoe UI,Arial" font-size="12.5" font-weight="700" fill="#7f858c">V-341-x</text></g><g><title>E-341-x</title><rect x="328" y="130" width="96" height="40" rx="4" fill="#fff" stroke="#D6DAE0" stroke-width="1.4"/><text x="376.0" y="155.0" text-anchor="middle" font-family="Segoe UI,Arial" font-size="12.5" font-weight="700" fill="#7f858c">E-341-x</text></g><g><title>E-342-1..6</title><rect x="468" y="130" width="100" height="40" rx="4" fill="#fff" stroke="#D6DAE0" stroke-width="1.4"/><text x="518.0" y="155.0" text-anchor="middle" font-family="Segoe UI,Arial" font-size="12.5" font-weight="700" fill="#7f858c">E-342-1..6</text></g><g><title>V-343</title><rect x="620" y="130" width="84" height="40" rx="4" fill="#fff" stroke="#D6DAE0" stroke-width="1.4"/><text x="662.0" y="155.0" text-anchor="middle" font-family="Segoe UI,Arial" font-size="12.5" font-weight="700" fill="#7f858c">V-343</text></g><g><title>E-311</title><rect x="752" y="130" width="96" height="40" rx="4" fill="#fff" stroke="#D6DAE0" stroke-width="1.4"/><text x="800.0" y="155.0" text-anchor="middle" font-family="Segoe UI,Arial" font-size="12.5" font-weight="700" fill="#7f858c">E-311</text></g><g><title>E-354</title><rect x="892" y="130" width="96" height="40" rx="4" fill="#fff" stroke="#D6DAE0" stroke-width="1.4"/><text x="940.0" y="155.0" text-anchor="middle" font-family="Segoe UI,Arial" font-size="12.5" font-weight="700" fill="#7f858c">E-354</text></g><path d="M 96,130 L 96,97" fill="none" stroke="#8B939C" stroke-width="1.1"/><g transform="translate(96,86)"><title>PT-3411.x &#183; suction P &#183; PCS</title><circle cx="0" cy="0" r="11" fill="#fff" stroke="#15171A" stroke-width="1.3" stroke-linecap="round"/><text x="0" y="-2.2" text-anchor="middle" font-family="Consolas,monospace" font-size="7.4" font-weight="700" fill="#15171A">PT</text><text x="0" y="6.4" text-anchor="middle" font-family="Consolas,monospace" font-size="6.6" font-weight="400" fill="#15171A">3411.x</text></g><text x="96" y="68" text-anchor="middle" font-family="Consolas,monospace" font-size="6.1" fill="#8B939C" paint-order="stroke" stroke="#fff" stroke-width="3">suction P</text><path d="M 140,130 L 140,97" fill="none" stroke="#8B939C" stroke-width="1.1"/><g transform="translate(140,86)"><title>TT-3419.x &#183; suction T &#183; LSD</title><path d="M 0,-14 L 14,0 L 0,14 L -14,0 Z" fill="#fff" stroke="#8A6D00" stroke-width="1.3" stroke-linecap="round"/><circle cx="0" cy="0" r="10.4" fill="none" stroke="#8A6D00" stroke-width="1.3" stroke-linecap="round"/><text x="0" y="-2.2" text-anchor="middle" font-family="Consolas,monospace" font-size="7.4" font-weight="700" fill="#8A6D00">TT</text><text x="0" y="6.4" text-anchor="middle" font-