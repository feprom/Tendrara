nsolas,monospace" font-size="6.2" font-weight="700" fill="#4A4F57">MAIN + ADDITIONAL INJECTION</text><text x="872" y="86" font-family="Consolas,monospace" font-size="6.0" fill="#8B939C">into the rotors &#8212; this is the oil</text><text x="872" y="95" font-family="Consolas,monospace" font-size="6.0" fill="#8B939C">that SEALS them and carries the heat</text><text x="14" y="56" font-family="Consolas,monospace" font-size="6.6" font-weight="700" fill="#C8102E">&#9312; INJECTION CIRCUIT &#183; NOT pumped</text><text x="14" y="66" font-family="Consolas,monospace" font-size="6.1" fill="#8B939C">separator pressure pushes it</text><rect x="12.0" y="177.5" width="92" height="17" rx="3" fill="#fff" stroke="#4A4F57" stroke-width="1.3"/><text x="58" y="189.6" font-family="Consolas,monospace" font-size="7.4" font-weight="700" fill="#4A4F57" text-anchor="middle">V-341-1 N3</text><g data-run="C2a"><polyline points="106,186 132,186" fill="none" stroke="#7A5C00" stroke-width="2.0" stroke-linejoin="round"/></g><g data-eq="341-ST-103.1"><rect x="134" y="177" width="26" height="18" rx="2" fill="#fff" stroke="currentColor" stroke-width="1.4"/><path d="M 138,181 L 156,191 M 138,191 L 156,181" stroke="currentColor" stroke-width="1"/></g><text x="147" y="162" text-anchor="middle" font-family="Consolas,monospace" font-size="6.0" fill="#8B939C">341-ST-103.1</text><text x="147" y="171" text-anchor="middle" font-family="Consolas,monospace" font-size="6.0" fill="#8B939C">suction strainer</text><g data-run="C2b"><polyline points="162,186 192,186" fill="none" stroke="#7A5C00" stroke-width="2.0" stroke-linejoin="round"/></g><g data-eq="P-341-1"><circle cx="210" cy="186" r="14" fill="#fff" stroke="currentColor" stroke-width="1.6"/><polygon points="223,186 198,176 198,196" fill="none" stroke="currentColor" stroke-width="1.4"/><text x="210" y="160" font-family="Consolas,monospace" font-size="7.6" font-weight="700" fill="#15171A" text-anchor="middle" paint-order="stroke" stroke="#fff" stroke-width="3" class="tagtx">P-341-1</text></g><text x="210" y="151" text-anchor="middle" font-family="Consolas,monospace" font-size="6.0" fill="#8B939C">gear &#183; 135 l/min</text><text x="210" y="210" text-anchor="middle" font-family="Consolas,monospace" font-size="6.0" fill="#8B939C">MP-341-1 &#183; 4 kW &#183; DOL</text><text x="210" y="219" text-anchor="middle" font-family="Consolas,monospace" font-size="6.0" font-weight="700" fill="#C8102E">MAGNETIC COUPLING &#8212; seal-less</text><g data-run="C2c"><polyline points="224,186 452,186" fill="none" stroke="#7A5C00" stroke-width="2.0" stroke-linejoin="round" marker-end="url(#a7A5C00)"/></g><text x="348" y="177" text-anchor="middle" font-family="Consolas,monospace" font-size="6.1" fill="#8B939C">3&quot;-LO-341113 &#8594; 1&#189;&quot;-LO-341114-3C1</text><g class="vlv" data-vtag="PSV-3418.1" data-vkind="SHUTDOWN_VALVE" transform="translate(276,158)"><path d="M -9,-6.5 L -9,6.5 L 0,0 Z" fill="#F7C600" stroke="#8A6D00" stroke-width="1.4" stroke-linecap="round"/><path d="M 9,-6.5 L 9,6.5 L 0,0 Z" fill="#F7C600" stroke="#8A6D00" stroke-width="1.4" stroke-linecap="round"/><line x1="0" y1="0" x2="0" y2="-11" stroke="#8A6D00" stroke-width="1.4" stroke-linecap="round"/><rect x="-6" y="-18.5" width="12" height="7.5" fill="#F7C600" stroke="#8A6D00" stroke-width="1.4" stroke-linecap="round"/><line x1="-6" y1="-11" x2="6" y2="-18.5" stroke="#8A6D00" stroke-width="1.4" stroke-linecap="round"/></g><g data-run="PSVb"><polyline points="276,186 276,166" fill="none" stroke="#8B939C" stroke-width="1.5" stroke-linejoin="round"/></g><text x="300" y="143" font-family="Consolas,monospace" font-size="6.0" font-weight="700" fill="#8A6D00">PSV-3418.1 &#183; 6 bar differential</text><text x="300" y="152" font-family="Consolas,monospace" font-size="6.0" font-weight="700" fill="#8A6D00">relieves back to the pump suction</text><g data-run="C2d"><polyline points="590,186 634,186" fill="none" stroke="#7A5C00" stroke-width="2.0" stroke-linejoin="round" marker-