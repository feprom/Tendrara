4" fill="none" stroke="#0B5CAD" stroke-width="2.2" stroke-linejoin="round" marker-end="url(#a0B5CAD)"/></g><g data-eq="E-354"><circle cx="822" cy="214" r="25" fill="#fff" stroke="currentColor" stroke-width="1.7"/><path d="M 809.0,225.5 L 819.5,225.5 L 824.5,202.5 L 835.0,202.5" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linejoin="round" stroke-linecap="round"/><text x="822" y="250" font-family="Consolas,monospace" font-size="8.2" font-weight="700" fill="#15171A" text-anchor="middle" paint-order="stroke" stroke="#fff" stroke-width="3" class="tagtx">E-354</text><text x="822" y="259" font-family="Consolas,monospace" font-size="6.4" fill="#4A4F57" text-anchor="middle" paint-order="stroke" stroke="#fff" stroke-width="3">U350 &#183; ammonia / MR cooler</text></g><text x="596" y="192" font-family="Consolas,monospace" font-size="6.2" fill="#8B939C">4&quot;-AN-000124-3L1</text><text x="880" y="218" font-family="Consolas,monospace" font-size="6.4" font-weight="700" fill="#4A4F57">shell level 90 %</text><text x="14" y="106" font-family="Consolas,monospace" font-size="6.8" font-weight="700" fill="#C8102E">THE SPLIT IS BY DEMAND, NOT BY A SPLITTER</text><text x="14" y="117" font-family="Consolas,monospace" font-size="6.4" fill="#4A4F57">there is no flow controller and no ratio here. Each user simply</text><text x="14" y="127" font-family="Consolas,monospace" font-size="6.4" fill="#4A4F57">opens its own level valve as fast as it boils the liquid off.</text><text x="14" y="141" font-family="Consolas,monospace" font-size="6.4" font-weight="700" fill="#15171A">C1S design case: E-354 takes 15 714 kg/h and E-311 1569 kg/h</text><text x="14" y="151" font-family="Consolas,monospace" font-size="6.4" fill="#8B939C">&#8212; ten to one. E-354 is the load; E-311 is the trim.</text><text x="14" y="172" font-family="Consolas,monospace" font-size="6.8" font-weight="700" fill="#C8102E">LIQUID AT THE VALVE</text><text x="14" y="183" font-family="Consolas,monospace" font-size="6.4" fill="#4A4F57">57 &#176;C and 25.3 barg on the way in &#183; on the way out it flashes to</text><text x="14" y="193" font-family="Consolas,monospace" font-size="6.4" fill="#4A4F57">8.8 &#176;C / 5.07 barg at E-311 and 1.9 &#176;C / 3.77 barg at E-354.</text><text x="14" y="207" font-family="Consolas,monospace" font-size="6.6" font-weight="700" fill="#15171A">That pressure drop IS the refrigeration.</text><line x1="14" y1="270" x2="986" y2="270" stroke="#D6DAE0" stroke-width=".8"/><text x="14" y="284" font-family="Consolas,monospace" font-size="6.4" fill="#4A4F57">A LOW RECEIVER LEVEL (LAL-3401 at 25 %) means the users are about to lose their liquid seal &#8212; check the charge and the condenser duty before you chase the level valves.</text></svg>',
    users: '<svg viewBox="0 0 1000 328" xmlns="http://www.w3.org/2000/svg"><polygon points="14,69.0 96,69.0 110,84 96,99.0 14,99.0" fill="#fff" stroke="#1F8A4C" stroke-width="1.3"/><text x="21" y="83" font-family="Consolas,monospace" font-size="9" font-weight="700" fill="#15171A" text-anchor="start">V-343</text><text x="21" y="94" font-family="Consolas,monospace" font-size="6.8" fill="#4A4F57" text-anchor="start">liquid</text><g data-run="iE-311"><polyline points="112,84 166,84" fill="none" stroke="#1F8A4C" stroke-width="2.2" stroke-linejoin="round" marker-end="url(#a1F8A4C)"/></g><circle cx="140" cy="84" r="8" fill="#fff" stroke="#1F8A4C" stroke-width="1.3"/><text x="140" y="86.8" font-family="Consolas,monospace" font-size="6.4" font-weight="700" fill="#1F8A4C" text-anchor="middle" class="baltx">R4</text><text x="112" y="69" font-family="Consolas,monospace" font-size="6.0" fill="#8B939C">1&#189;&quot;-AN-000201-3L1</text><g data-eq="LV-3111"><g class="vlv" data-vtag="LV-3111" data-vkind="CONTROL_VALVE" transform="translate(186,84)"><path d="M -9,-6.5 L -9,6.5 L 0,0 Z" fill="#fff" stroke="#333" stroke-width="1.4" stroke-linecap="round"/><path d="M 9,-6.5 L 9,6.5 L 0,0 Z" fill="#fff" stroke="#333" stroke-width="1.4" stroke-linecap="round"/><line x1="0" y1="0" x2="0" y2="-13" stroke="#333" stroke-width="1.4" stroke-linecap="round"/><path d="M -7,-13 A 7,5.5 0 0 1 7,-13 Z" fill="#fff" stroke="#333" stroke-width="1.4" stroke-linecap="round"/></g></g><text x="186" y="108" text-anchor="middle" font-family="Consolas,monospace" font-size="6.6" font-weight="700" fill="#15171A">LV-3111</text><g data-run="xE-311"><polyline points="204,84 250,84" fill="none" stroke="#0B5CAD" stroke-width="2.2" stroke-linejoin="round" marker-end="url(#a0B5CAD)"/></g><circle cx="228" cy="84" r="8" fill="#fff" stroke="#0B5CAD" stroke-width="1.3"/><text x="228" y="86.8" font-family="Consolas,monospace" font-size="6.4" font-weight="700" fill="#0B5CAD" text-anchor="middle" class="baltx">R5</text><g data-eq="E-311"><circle cx="282" cy="84" r="27" fill="#fff" stroke="currentColor" stroke-width="1.7"/><path d="M 267.96,96.42 L 279.3,96.42 L 284.7,71.58 L 296.04,71.58" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linejoin="round" stroke-linecap="round"/><text x="282" y="48" font-family="Consolas,monospace" font-size="8.2" font-weight="700" fill="#15171A" text-anchor="middle" paint-order="stroke" stroke="#fff" stroke-width="3" class="tagtx">E-311</text></g><g transform="translate(186,40)"><title>LIC-3111 &#183; shell liquid level</title><rect x="-11" y="-11" width="22" height="22" fill="#fff" stroke="#15171A" stroke-width="1.3" stroke-linecap="round"/><circle cx="0" cy="0" r="10.6" fill="none" stroke="#15171A" stroke-width="1.3" stroke-linecap="round"/><line x1="-11" y1="0" x2="11" y2="0" stroke="#15171A" stroke-width="1.3" stroke-linecap="round"/><text x="0" y="-2.2" text-anchor="middle" font-family="Consolas,monospace" font-size="7.4" font-weight="700" fill="#15171A">LIC</text><text x="0" y="6.4" text-anchor="middle" font-family="Consolas,monospace" font-size="6.6" font-weight="400" fill="#15171A">3111</text></g><path d="M 186,51 L 186,73" fill="none" stroke="#8B939C" stroke-width="1.1" stroke-dasharray="5 3"/><g transform="translate(282,130)"><title>LT-3111 &#183; level transmitter</title><circle cx="0" cy="0" r="11" fill="#fff" stroke="#15171A" stroke-width="1.3" stroke-linecap="round"/><text x="0" y="-2.2" text-anchor="middle" font-family="Consolas,monospace" font-size="7.4" font-weight="700" fill="#15171A">LT</text><text x="0" y="6.4" text-anchor="middle" font-family="Consolas,monospace" font-size="6.6" font-weight="400" fill="#15171A">3111</text></g><path d="M 282,111 L 282,119" fill="none" stroke="#8B939C" stroke-width="1.1"/><path d="M 270,130 L 200,130" fill="none" stroke="#4A4F57" stroke-width="1.15" stroke-linecap="round" stroke-linejoin="round" stroke-dasharray="4 3"/><g transform="translate(235.0,130)"><circle cx="-4" cy="0" r="1.9" fill="#fff" stroke="#4A4F57" stroke-width="1.15"/><circle cx="4" cy="0" r="1.9" fill="#fff" stroke="#4A4F57" stroke-width="1.15"/></g><path d="M-4.5,-3 L1,0 L-4.5,3 Z" fill="#4A4F57" transform="translate(200,130)"/><text x="332" y="54" font-family="Consolas,monospace" font-size="6.6" font-weight="700" fill="#4A4F57">NATURAL GAS PRECOOLER &#183; UNIT 310 &#183; NORMAL LEVEL 35 %</text><text x="332" y="64" font-family="Consolas,monospace" font-size="6.3" fill="#8B939C">flooded shell &#8212; the ammonia BOILS on the shell side</text><text x="332" y="102" font-family="Consolas,monospace" font-size="6.3" font-weight="700" fill="#4A4F57">too LOW: no cooling &#183; too HIGH: liquid carries over to the compressor suction</text><polygon points="14,181.0 96,181.0 110,196 96,211.0 14,211.0" fill="#fff" stroke="#1F8A4C" stroke-width="1.3"/><text x="21" y="195" font-family="Consolas,monospace" font-size="9" font-weight="700" fill="#15171A" text-anchor="start">V-343</text><text x="21" y="206" font-family="Consolas,monospace" font-size="6.8" fill="#4A4F57" text-anchor="start">liquid</text><g data-run="iE-354"><polyline points="112,196 166,196" fill="none" stroke="#1F8A4C" stroke-width="2.2" stroke-linejoin="round" marker-end="url(#a1F8A4C)"/></g><circle cx="140" cy="196" r="8" fill="#fff" stroke="#1F8A4C" stroke-width="1.3"/><text x="140" y="198.8" font-family="Consolas,monospace" font-size="6.4" font-weight="700" fill="#1F8A4C" text-anchor="middle" class="baltx">R10</text><text x="112" y="181" font-family="Consolas,monospace" font-size="6.0" fill="#8B939C">4&quot;-AN-000124-3L1</text><g data-eq="LV-3540"><g class="vlv" data-vtag="LV-3540" data-vkind="CONTROL_VALVE" transform="translate(186,196)"><path d="M -9,-6.5 L -9,6.5 L 0,0 Z" fill="#fff" stroke="#333" stroke-width="1.4" stroke-linecap="round"/><path d="M 9,-6.5 L 9,6.5 L 0,0 Z" fill="#fff" stroke="#333" stroke-width="1.4" stroke-linecap="round"/><line x1="0" y1="0" x2="0" y2="-13" stroke="#333" stroke-width="1.4" stroke-linecap="round"/><path d="M -7,-13 A 7,5.5 0 0 1 7,-13 Z" fill="#fff" stroke="#333" stroke-width="1.4" stroke-linecap="round"/></g></g><text x="186" y="220" text-anchor="middle" font-family="Consolas,monospace" font-size="6.6" font-weight="700" fill="#15171A">LV-3540</text><g data-run="xE-354"><polyline points="204,196 250,196" fill="none" stroke="#0B5CAD" stroke-width="2.2" stroke-linejoin="round" marker-end="url(#a0B5CAD)"/></g><circle cx="228" cy="196" r="8" fill="#fff" stroke="#0B5CAD" stroke-width="1.3"/><text x="228" y="198.8" font-family="Consolas,monospace" font-size="6.4" font-weight="700" fill="#0B5CAD" text-anchor="middle" class="baltx">R11</text><g data-eq="E-354"><circle cx="282" cy="196" r="27" fill="#fff" stroke="currentColor" stroke-width="1.7"/><path d="M 267.96,208.42 L 279.3,208.42 L 284.7,183.58 L 296.04,183.58" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linejoin="round" stroke-linecap="round"/><text x="282" y="160" font-family="Consolas,monospace" font-size="8.2" font-weight="700" fill="#15171A" text-anchor="middle" paint-order="stroke" stroke="#fff" stroke-width="3" class="tagtx">E-354</text></g><g transform="translate(186,152)"><title>LIC-3540 &#183; shell liquid level</title><rect x="-11" y="-11" width="22" height="22" fill="#fff" stroke="#15171A" stroke-width="1.3" stroke-linecap="round"/><circle cx="0" cy="0" r="10.6" fill="none" stroke="#15171A" stroke-width="1.3" stroke-linecap="round"/><line x1="-11" y1="0" x2="11" y2="0" stroke="#15171A" stroke-width="1.3" stroke-linecap="round"/><text x="0" y="-2.2" text-anchor="middle" font-family="Consolas,monospace" font-size="7.4" font-weight="700" fill="#15171A">LIC</text><text x="0" y="6.4" text-anchor="middle" font-family="Consolas,monospace" font-size="6.6" font-weight="400" fill="#15171A">3540</text></g><path d="M 186,163 L 186,185" fill="none" stroke="#8B939C" stroke-width="1.1" stroke-dasharray="5 3"/><g transform="translate(282,242)"><title>LT-3540 &#183; level transmitter</title><circle cx="0" cy="0" r="11" fill="#fff" stroke="#15171A" stroke-width="1.3" stroke-linecap="round"/><text x="0" y="-2.2" text-anchor="middle" font-family="Consolas,monospace" font-size="7.4" font-weight="700" fill="#15171A">LT</text><text x="0" y="6.4" text-anchor="middle" font-family="Consolas,monospace" font-size="6.6" font-weight="400" fill="#15171A">3540</text></g><path d="M 282,223 L 282,231" fill="none" stroke="#8B939C" stroke-width="1.1"/><path d="M 270,242 L 200,242" fill="none" stroke="#4A4F57" stroke-width="1.15" stroke-linecap="round" stroke-linejoin="round" stroke-dasharray="4 3"/><g transform="translate(235.0,242)"><circle cx="-4" cy="0" r="1.9" fill="#fff" stroke="#4A4F57" stroke-width="1.15"/><circle cx="4" cy="0" r="1.9" fill="#fff" stroke="#4A4F57" stroke-width="1.15"/></g><path d="M-4.5,-3 L1,0 L-4.5,3 Z" fill="#4A4F57" transform="translate(200,242)"/><text x="332" y="166" font-family="Consolas,monospace" font-size="6.6" font-weight="700" fill="#4A4F57">AMMONIA / MR COOLER &#183; UNIT 350 &#183; NORMAL LEVEL 90 %</text><text x="332" y="176" font-family="Consolas,monospace" font-size="6.3" fill="#8B939C">flooded shell &#8212; the ammonia BOILS on the shell side</text><text x="332" y="214" font-family="Consolas,monospace" font-size="6.3" font-weight="700" fill="#4A4F57">too LOW: no cooling &#183; too HIGH: liquid carries over to the compressor suction</text><text x="306" y="130" font-family="Consolas,monospace" font-size="6.1" fill="#8B939C">the level valve is the ONLY thing</text><text x="306" y="139" font-family="Consolas,monospace" font-size="6.1" fill="#8B939C">between 25 barg and 5 barg</text><g data-run="vA"><polyline points="309,84 560,84" fill="none" stroke="#00A0B0" stroke-width="2.2" stroke-linejoin="round" marker-end="url(#a00A0B0)"/></g><circle cx="430" cy="84" r="8" fill="#fff" stroke="#00A0B0" stroke-width="1.3"/><text x="430" y="86.8" font-family="Consolas,monospace" font-size="6.4" font-weight="700" fill="#00A0B0" text-anchor="middle" class="baltx">R6</text><g data-eq="PCV-3101"><g class="vlv" data-vtag="PCV-3101" data-vkind="CONTROL_VALVE" transform="translate(578,84)"><path d="M -9,-6.5 L -9,6.5 L 0,0 Z" fill="#fff" stroke="#333" stroke-width="1.4" stroke-linecap="round"/><path d="M 9,-6.5 L 9,6.5 L 0,0 Z" fill="#fff" stroke="#333" stroke-width="1.4" stroke-linecap="round"/><line x1="0" y1="0" x2="0" y2="-13" stroke="#333" stroke-width="1.4" stroke-linecap="round"/><path d="M -7,-13 A 7,5.5 0 0 1 7,-13 Z" fill="#fff" stroke="#333" stroke-width="1.4" stroke-linecap="round"/></g></g><text x="578" y="60" text-anchor="middle" font-family="Consolas,monospace" font-size="6.8" font-weight="700" fill="#15171A">PCV-3101 &#183; SET 4.5 barg</text><g transform="translate(636,40)"><title>PEV-3101 &#183; solenoid on PCV-3101 &#183; the HMI screen prints PEV-31011</title><circle cx="0" cy="0" r="11" fill="#fff" stroke="#15171A" stroke-width="1.3" stroke-linecap="round"/><text x="0" y="-2.2" text-anchor="middle" font-family="Consolas,monospace" font-size="7.4" font-weight="700" fill="#15171A">PEV</text><text x="0" y="6.4" text-anchor="middle" font-family="Consolas,monospace" font-size="6.6" font-weight="400" fill="#15171A">3101</text></g><path d="M 636,51 L 636,72 L 592,72" fill="none" stroke="#8B939C" stroke-width="1.1" stroke-dasharray="5 3"/><g data-run="vA2"><polyline points="596,84 700,84 700,274" fill="none" stroke="#00A0B0" stroke-width="2.2" stroke-linejoin="round"/></g><text x="672" y="38" font-family="Consolas,monospace" font-size="6.6" font-weight="700" fill="#C8102E">HOLDS E-311 AT THE HIGHER EVAPORATING PRESSURE</text><text x="672" y="48" font-family="Consolas,monospace" font-size="6.2" fill="#4A4F57">5.02 barg at E-311 against 3.62 barg at E-354, so the natural gas</text><text x="672" y="58" font-family="Consolas,monospace" font-size="6.2" fill="#4A4F57">is never chilled into HYDRATE conditions ahead of the driers</text><text x="986" y="100" text-anchor="end" font-family="Consolas,monospace" font-size="6.0" fill="#8B939C">3&quot;-AN-000204-3L1-C25</text><g data-run="vB"><polyline points="309,196 860,196 860,274" fill="none" stroke="#00A0B0" stroke-width="2.6" stroke-linejoin="round"/></g><circle cx="760" cy="196" r="8" fill="#fff" stroke="#00A0B0" stroke-width="1.3"/><text x="760" y="198.8" font-family="Consolas,monospace" font-size="6.4" font-weight="700" fill="#00A0B0" text-anchor="middle" class="baltx">R12</text><text x="760" y="184" text-anchor="middle" font-family="Consolas,monospace" font-size="6.2" fill="#8B939C">10&quot;-AN-000123-3L1-C35 &#8212; the big return &#183; 15 714 kg/h</text><line x1="14" y1="254" x2="986" y2="254" stroke="#D6DAE0" stroke-width=".8"/><g data-run="HDR"><polyline points="920,286 140,286" fill="none" stroke="#00A0B0" stroke-width="2.8" stroke-linejoin="round" marker-end="url(#a00A0B0)"/></g><circle cx="400" cy="286" r="8" fill="#fff" stroke="#00A0B0" stroke-width="1.3"/><text x="400" y="288.8" font-family="Consolas,monospace" font-size="6.4" font-weight="700" fill="#00A0B0" text-anchor="middle" class="baltx">R1</text><circle cx="700" cy="286" r="2.6" fill="#00A0B0"/><circle cx="860" cy="286" r="2.6" fill="#00A0B0"/><polygon points="138,270.0 28,270.0 14,286 28,302.0 138,302.0" fill="#fff" stroke="#00A0B0" stroke-width="1.3"/><text x="131" y="285" font-family="Consolas,monospace" font-size="9" font-weight="700" fill="#15171A" text-anchor="end">PK-341</text><text x="131" y="296" font-family="Consolas,monospace" font-size="6.8" fill="#4A4F57" text-anchor="end">to the compressors</text><text x="500" y="304" text-anchor="middle" font-family="Consolas,monospace" font-size="6.6" font-weight="700" fill="#00A0B0">12&quot;-AN-340009-3L1-C35 &#183; COMMON SUCTION HEADER &#183; 1.3 &#176;C &#183; 3.62 barg</text><g transform="translate(922,252)"><title>PT-3552 &#183; measured at the E-354 outlet &#183; 0..34.47 barg</title><circle cx="0" cy="0" r="11" fill="#fff" stroke="#15171A" stroke-width="1.3" stroke-linecap="round"/><text x="0" y="-2.2" text-anchor="middle" font-family="Consolas,monospace" font-size="7.4" font-weight="700" fill="#15171A">PT</text><text x="0" y="6.4" text-anchor="middle" font-family="Consolas,monospace" font-size="6.6" font-weight="400" fill="#15171A">3552</text></g><path d="M 922,263 L 922,278" fill="none" stroke="#8B939C" stroke-width="1.1"/><text x="848" y="240" text-anchor="end" font-family="Consolas,monospace" font-size="6.2" font-weight="700" fill="#4A4F57">PT-3552 &#8594; PIC-3552 &#8212; the master</text><text x="848" y="249" text-anchor="end" font-family="Consolas,monospace" font-size="6.2" fill="#8B939C">that sets compressor capacity</text><text x="14" y="322" font-family="Consolas,monospace" font-size="6.3" fill="#4A4F57">Both returns must be DRY vapour. Anything liquid that reaches this header goes straight into a screw compressor &#8212; which is why the two level loops matter more than any other loop in the unit.</text></svg>',
