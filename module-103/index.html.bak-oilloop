  var CLASS103={"340": {"MECH": [["FAN", "Fans", 73], ["HX", "Exchangers", 7], ["EQ", "Compressors", 4], ["FILTER", "Filters", 1], ["PUMP", "Pumps", 1], ["EQ", "Separators", 1], ["EQ", "Process tanks", 1], ["HEATER", "Heaters", 1]], "ELEC": [["MOT", "Motors", 120]], "INST": [["INST", "Gauges", 51], ["INSTP", "Transmitters", 34], ["INSTZ", "Switches", 24], ["VLV", "Solenoids", 18], ["VLV", "Relief valves", 18], ["VLV", "Control valves", 6]], "CTRL": [["IO", "IO channels", 83], ["ST", "RIO panels", 14], ["CE", "Sequences", 8], ["ST", "Junction boxes", 5], ["LOOP", "Control loops", 1]]}};
  var UNITSTATS103={"340": {"mcc": 112, "io": 83, "rio": 14, "starters": 10, "mv": null, "dMECH": 89, "dELEC": 120, "dINST": 151, "dCTRL": 111, "note": "plant_manual_valves holds no rows for area 340, so there is no manual-valve figure to print - the register is not digitised, which is not the same as a count of zero. The area also carries 5 SAFETY-class assets that belong to no discipline square: 2 extinguishers (E-342-1 and PK-341-1), 1 alarm pushbutton with status REMOVED, 1 emergency shower and 1 spillage kit (both at E-342-4). The 5 ammonia gas detectors GD-05…GD-09 are in plant_safety_devices only and are not plant_assets, so they are counted nowhere. 476 assets in total = 151 instrumentation + 120 electrical + 111 control + 89 mechanical + 5 safety."}};
  var TILE_NAV103={"Fans": ["equipment", null], "Exchangers": ["equipment", null], "Compressors": ["equipment", null], "Filters": ["equipment", null], "Pumps": ["equipment", null], "Separators": ["equipment", null], "Process tanks": ["equipment", null], "Heaters": ["equipment", null], "Motors": ["motors", null], "Gauges": ["instruments", null], "Transmitters": ["instruments", null], "Switches": ["instruments", null], "Solenoids": ["valves", null], "Relief valves": ["valves", null], "Control valves": ["valves", null], "IO channels": ["io", null], "RIO panels": ["starters", null], "Sequences": ["sequences", null], "Junction boxes": ["jbs", null], "Control loops": ["loops", null]};
</script>
<script>
  // shared helpers for the module-102 data views
  function esc102(s){return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');}
  function tbl102(cols,rows){
    var h='<thead><tr>'+cols.map(function(c){return '<th>'+esc102(c)+'</th>';}).join('')+'</tr></thead>';
    var b='<tbody>'+rows.map(function(r){
      return '<tr>'+r.map(function(v,i){
        var cls=i===0?'tg':(i>=2?'ty':'');
        var st=(String(r[0]).indexOf('†')>=0)?' style="color:#B26A00;"':'';
        return '<td'+(cls?' class="'+cls+'"':'')+st+'>'+esc102(v===''?'—':v)+'</td>';}).join('')+'</tr>';
    }).join('')+'</tbody>';
    return '<table class="objtbl">'+h+b+'</table>';
  }
  function ceHTML(d){
    var head='<tr><th>Cause</th><th>Instrument</th><th>Type</th><th>Set point</th><th>Description</th>'+
      d.effects.map(function(e){return '<th class="eff" data-eff="'+esc102(e.tag)+'">'+esc102(e.tag)+'</th>';}).join('')+'</tr>';
    var body=d.causes.map(function(c,ci){
      var cells=d.effects.map(function(e){
        var on=c.eff.indexOf(e.tag)>=0;
        return '<td class="mk'+(on?' hit':'')+'" data-eff="'+esc102(e.tag)+'">'+(on?'●':'')+'</td>';}).join('');
      return '<tr data-ci="'+ci+'"><td class="tg">'+esc102(c.tag)+'</td><td class="ins">'+esc102(c.ins)+'</td>'+
        '<td><span class="cebadge '+(c.ty==='PSD'?'psd':'lsd')+'">'+esc102(c.ty)+'</span></td>'+
        '<td class="sp">'+esc102(c.sp)+'</td><td class="ds">'+esc102(c.ds)+'</td>'+cells+'</tr>';}).join('');
    var legend='<div class="celegend"><b>Effects (columns):</b><br>'+
      d.effects.map(function(e){return '<span class="cetag">'+esc102(e.tag)+'</span> — '+esc102(e.action)+' · '+esc102(e.desc);}).join('<br>')+
      '<div class="row" style="margin-top:6px;">'+esc102(d.note)+'</div></div>'+
      '<div class="cehint">▸ <b>Hover a cause row</b> to light its effect(s) · <b>hover an effect header</b> to light the causes that trigger it.</div>';
    return '<div class="cewrap"><table class="cematrix"><thead>'+head+'</thead><tbody>'+body+'</tbody></table>'+legend+'</div>';
  }
  function ceWire(host){
    var table=host.querySelector('.cematrix'); if(!table) return;
    var rows=[].slice.call(table.querySelectorAll('tbody tr'));
    var ths=[].slice.call(table.querySelectorAll('th.eff'));
    function clear(){
      rows.forEach(function(r){r.classList.remove('hi','dim');});
      ths.forEach(function(t){t.classList.remove('effhi');});
      [].slice.call(table.querySelectorAll('td.mk')).forEach(function(td){td.classList.remove('mkhi');});
    }
    rows.forEach(function(r){
      r.addEventListener('mouseenter',function(){
        clear(); r.classList.add('hi');
        [].slice.call(r.querySelectorAll('td.mk.hit')).forEach(function(td){
          td.classList.add('mkhi');
          var e=td.getAttribute('data-eff');
          ths.forEach(function(t){ if(t.getAttribute('data-eff')===e) t.classList.add('effhi'); });
        });
      });
      r.addEventListener('mouseleave',clear);
    });
    ths.forEach(function(t){
      t.addEventListener('mouseenter',function(){
        clear(); t.classList.add('effhi');
        var e=t.getAttribute('data-eff');
        rows.forEach(function(r){
          var td=r.querySelector('td.mk.hit[data-eff="'+e+'"]');
          if(td){ r.classList.add('hi'); td.classList.add('mkhi'); } else { r.classList.add('dim'); }
        });
      });
      t.addEventListener('mouseleave',clear);
    });
  }
  // on-slide interactive C&E for both units
  (function(){
    [['ce340',CE340]].forEach(function(p){
      var host=document.getElementById(p[0]); if(!host) return;
      host.innerHTML=ceHTML(p[1]); ceWire(host);
    });
  })();
  /* ── discipline band — icons, cards and counting rules taken from eni/index.html
     (PV_ICONS + fact() + discBand()). The glyph paths are the same strings, so a
     pump on the portal and a pump on the slide are the same drawing. The counts
     are read from the unit tables below, never typed into the markup — same rule
     as the portal. Switchgear / loads / generators are portal-level electrical
     objects and are NOT shown here: a process unit slide has no switchboard. */
  var PV_ICONS102={
    // ── from eni/index.html (PV_ICONS), unchanged
    EQ:'<rect x="4.3" y="2.6" width="7.4" height="10.8" rx="3.6"/><line x1="4.3" y1="6" x2="11.7" y2="6"/><line x1="4.3" y1="10" x2="11.7" y2="10"/>',
    MOT:'<circle cx="7.6" cy="8" r="4.9"/><path d="M5.5 10.1V5.9l2.1 2.5 2.1-2.5v4.2"/><line x1="12.5" y1="8" x2="14" y2="8"/>',
    INST:'<circle cx="8" cy="8" r="5.4"/><line x1="2.6" y1="8" x2="13.4" y2="8"/>',
    ST:'<rect x="2.6" y="2.6" width="10.8" height="10.8" rx="1.2"/><line x1="2.6" y1="5.7" x2="13.4" y2="5.7"/><circle cx="4.4" cy="4.15" r=".65"/><line x1="5" y1="8.3" x2="11" y2="8.3"/><line x1="5" y1="10.6" x2="11" y2="10.6"/>',
    ALM:'<path d="M8 2.4c2.1 0 3.4 1.5 3.4 3.9v2.1l1.1 1.6H3.5l1.1-1.6V6.3C4.6 3.9 5.9 2.4 8 2.4Z"/><path d="M6.7 12a1.35 1.35 0 0 0 2.6 0"/>',
    CE:'<rect x="2.5" y="2.5" width="11" height="11" rx="1"/><line x1="6.2" y1="2.5" x2="6.2" y2="13.5"/><line x1="9.8" y1="2.5" x2="9.8" y2="13.5"/><line x1="2.5" y1="6.2" x2="13.5" y2="6.2"/><line x1="2.5" y1="9.8" x2="13.5" y2="9.8"/>',
    LOAD:'<path d="M8.8 2 L4.3 8.8 H7.4 L6.4 14 L11.6 6.6 H8.2 Z"/>',
    /* instruments by measured variable — the ISA balloon letter is a smudge at card
       size (measured), so each family carries the shape of what it measures */
    INSTP:'<circle cx="8" cy="8" r="5.4"/><path d="M8 8 L10.8 5.2"/><circle cx="8" cy="8" r="1" fill="currentColor" stroke="none"/>',
    INSTT:'<path d="M6.5 9.3V3.6a1.5 1.5 0 0 1 3 0v5.7a2.7 2.7 0 1 1-3 0Z"/><circle cx="8" cy="11.6" r="1.15" fill="currentColor" stroke="none"/>',
    INSTL:'<rect x="3.8" y="2.6" width="8.4" height="10.8" rx="1.6"/><path d="M3.8 8.6c1.4 0 1.4 1.1 2.8 1.1s1.4-1.1 2.8-1.1 1.4 1.1 2.8 1.1"/>',
    INSTF:'<path d="M2.2 8h9.4"/><path d="M9.2 5.3 12.6 8 9.2 10.7"/><path d="M5.4 5.4v5.2M7 5.4v5.2" opacity=".5"/>',
    INSTZ:'<circle cx="8" cy="8" r="5.4"/><path d="M8 2.6v3M8 10.4v3M2.6 8h3M10.4 8h3"/>',
    INSTA:'<path d="M6.4 2.6h3.2M7.4 2.6v3.7L4.5 11.9a1.1 1.1 0 0 0 1 1.6h5a1.1 1.1 0 0 0 1-1.6L8.6 6.3V2.6"/><path d="M5.9 10.2h4.2"/>',
    INSTG:'<path d="M8 2.2c2.4 2.7 3.7 4.4 3.7 6.4a3.7 3.7 0 1 1-7.4 0c0-1.3.5-2.4 1.6-3.5.3 1 .9 1.7 1.7 2-.3-2 .2-3.5 2.4-4.9Z"/>',
    IO:'<rect x="4.3" y="4.3" width="7.4" height="7.4" rx="1"/><line x1="6.2" y1="2.6" x2="6.2" y2="4.3"/><line x1="9.8" y1="2.6" x2="9.8" y2="4.3"/><line x1="6.2" y1="11.7" x2="6.2" y2="13.4"/><line x1="9.8" y1="11.7" x2="9.8" y2="13.4"/><line x1="2.6" y1="6.2" x2="4.3" y2="6.2"/><line x1="2.6" y1="9.8" x2="4.3" y2="9.8"/><line x1="11.7" y1="6.2" x2="13.4" y2="6.2"/><line x1="11.7" y1="9.8" x2="13.4" y2="9.8"/>',
    /* ── process equipment — drawn to the shapes our own symbol pack declares
       (eni/tam-sym-proc.js: ISO 10628-2 / ISO 14617-8, built from primitives,
       nothing copied from the paywalled asset sets). The gear glyph that stood
       here before is a MAINTENANCE mark, not a machine: a pump is a volute
       circle, an exchanger a shell with its tube bundle, a filter a screened
       body, an air cooler a bundle with the fan over it, a heater a resistance
       in a box. The letter→class rule is the P&ID legend's own
       (plant_pid_legend · equipment_code): P pump · E exchanger · T column ·
       V vessel · F filter or fan · X electric heater. */
    PUMP:'<circle cx="7.6" cy="9.2" r="4"/><line x1="1.7" y1="9.2" x2="3.6" y2="9.2"/><path d="M7.6 5.2 V2.5 H12.7"/><line x1="4.1" y1="14.1" x2="11.1" y2="14.1"/>',
    HX:'<rect x="2.1" y="3.9" width="11.8" height="8.2" rx="1.2"/><path d="M2.1 6.4 H9.4a1.6 1.6 0 0 1 0 3.2 H2.1"/>',
    FILTER:'<rect x="3.7" y="2.6" width="8.6" height="10.8" rx="1.2"/><line x1="3.7" y1="5.6" x2="12.3" y2="5.6"/><line x1="3.7" y1="12.4" x2="12.3" y2="6.6"/>',
    FAN:'<rect x="2.4" y="9.3" width="11.2" height="4.2" rx="1"/><circle cx="8" cy="5" r="2.7"/><path d="M8 5V2.3M8 5l2.35 1.35M8 5L5.65 6.35"/>',
    HEATER:'<rect x="2.6" y="4.4" width="10.8" height="7.2" rx="1"/><path d="M4.9 9.8 L6.5 6.2 L8 9.8 L9.5 6.2 L11.1 9.8"/>',
    // control valve — bow-tie body + diaphragm dome (tam-sym-proc: modulating)
    VLV:'<path d="M3 5 L8 8.2 L3 11.4 Z"/><path d="M13 5 L8 8.2 L13 11.4 Z"/><line x1="8" y1="8.2" x2="8" y2="5.2"/><path d="M5.6 5.2a2.4 2.4 0 0 1 4.8 0Z"/>',
    // manual valve — same body, hand-wheel bar instead of the actuator
    MVLV:'<path d="M3 5 L8 8.2 L3 11.4 Z"/><path d="M13 5 L8 8.2 L13 11.4 Z"/><line x1="8" y1="8.2" x2="8" y2="4"/><line x1="5.7" y1="3.6" x2="10.3" y2="3.6"/>',
    // control loop — the one glyph the portal does not carry yet, drawn to the same rules
    LOOP:'<path d="M13 8a5 5 0 1 1-1.8-3.85"/><path d="M11.4 1.9v2.9H8.5"/>'
  };
  function ICON102(k){return '<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round">'+(PV_ICONS102[k]||'')+'</svg>';}
  function fact102(icon,n,label,g,f,fam){
    return '<button class="dfact" data-g="'+g+'"'+(f?' data-f="'+f+'"':'')+(fam?' data-fam="'+fam+'"':'')+'>'
      +'<span class="ficon">'+ICON102(icon)+'</span>'
      +'<span class="fbody"><span class="n">'+n+'</span><span class="l">'+esc102(label)+'</span></span></button>';
  }
  // ISO 14224-style class of an equipment row, from its tag and service
  function eqClass102(tag,service){
    tag=String(tag); service=String(service||'');
    if(/^P-/.test(tag)) return 'PUMP';
    if(/^E-/.test(tag)) return 'HX';
    if(/^X-/.test(tag)) return 'HEATER';
    if(/^F-/.test(tag)) return /fan/i.test(service)?'FAN':'FILTER';
    return 'VESSEL';
  }
  /* discipline totals = assets of that discipline in the area (plant_assets ×
     plant_asset_classes.discipline). They sit in the corner of each box instead of as a
     card, so nobody adds the breakdown up and expects to land on them: manual valves are
     still their own Stage-2 register, and hand/F&G points are in the instrument total
     without a card of their own. */
  /* ── tam-disc.js v0.4.1, INLINED ────────────────────────────────────────
     The deck is one file on purpose — it opens from a USB stick with no server
     and no network — so the pack is pasted in rather than linked. It is the same
     source as eni/tam-disc.js; if you change one, change both. Nothing below
     reads the DOM or the network. */
/* ═══════════════════════════════════════════════════════════════════════════
   tam-disc.js — DISCIPLINE SQUARES (treemap)  ·  v0.4.1
   ─────────────────────────────────────────────────────────────────────────
   Four squares, one per discipline, all the SAME SIZE. Inside each square the
   asset classes of that discipline are tiled by area: a class with twice the
   count gets twice the surface. The square is the discipline; the mosaic is
   what it is made of.

   WHY EQUAL SQUARES AND NOT PROPORTIONAL ONES
     Mechanical holds 362 assets and Instrumentation 1868. Sized against each
     other, Mechanical would be a stamp — and the reader would lose the ability
     to compare a pump count against a filter count, which is the comparison an
     operator actually makes. So the OUTER frame is constant (the disciplines are
     four equal chapters) and the INNER areas are proportional (inside a chapter,
     size means quantity). Cross-square areas are NOT comparable, and the corner
     total is printed on every square precisely so nobody has to guess.

   WHY A TREEMAP AND NOT A BAR CHART
     A bar chart of 7 classes needs 7 rows of label; the mosaic packs the same
     seven numbers into a square that sits next to three others without
     scrolling, and the eye reads "half of Mechanical is fans" in one look.

   THE ALGORITHM — squarified treemap (Bruls, Huizing & van Wijk, 2000)
     Rows are grown while adding one more item improves the WORST aspect ratio
     of the row; when it stops improving the row is laid down and a new one
     starts in the remaining rectangle. That is what keeps the tiles close to
     square and therefore readable. It is ~60 lines and has no dependencies —
     do not pull d3 for this.

   HOUSE RULES IT FOLLOWS
     · Zero dependencies, offline-first, one file, no build step. Same contract
       as tam-sym.js / tam-flow.js: drop the <script> in and call it.
     · It DRAWS what it is given and counts nothing itself. The caller passes the
       numbers already read from the registry (db-graphics §4: a graphic never
       invents a figure, and a figure absent from the data prints nothing).
     · Every tile can carry a `nav` string; the renderer wires the click and the
       cursor. No nav → no cursor change, no click.
     · Labels degrade instead of overflowing: a tile too small for its word keeps
       the number, a tile too small for the number keeps only its colour. Nothing
       is ever clipped mid-word.

   API
     TamDisc.square(group, opts)  → <svg> string for ONE discipline
     TamDisc.band(groups, opts)   → the four squares in a row (flex wrapper)
     TamDisc.squarify(items,w,h)  → [{item,x,y,w,h}]  (exported for tests)
     TamDisc.MARIO                → the four pure hues, keyed by discipline
     TamDisc.autoInk(hex)         → same hue, dark enough to read on the card

   COLOUR — one pure hue per discipline, no exceptions
     MECHANICAL red #E52521 · ELECTRICAL gold #F4C320 ·
     INSTRUMENTATION green #3FA540 · CONTROL royal blue #2B6BD1.

     [v0.3.1] Sampled pixel-for-pixel from the reference treemap Mario supplied
     rather than guessed: red came back #E52521, identical to what we already had;
     green #3FA540 and gold #F4C320 are a shade warmer than the #43B047 / #FBD000
     they replace; and CONTROL moves from #049CD8 — a cyan — to the reference's
     royal #2B6BD1, which is the difference Mario spotted. The DISCIPLINE MAPPING is
     unchanged (the reference calls mechanical blue and electrical red; ours does
     not, because that mapping is the product's discipline code).
     Side effect worth having: #2B6BD1 is dark enough that white text wins on the
     pure hue (5.09:1), so the control square reads white throughout like the
     reference, and the title ink comes back as the pure blue itself.
     Those four values are the product's discipline code and they are used HERE
     AT FULL SATURATION: the rule bar and the biggest tile of every square carry
     the pure hue. Nothing is muted "for contrast" — the earlier v0.1.0 exception
     that shipped electrical as #E0A800 is gone.

     The one place a pure hue cannot be used verbatim is TEXT ON WHITE: pure
     #FBD000 as a 8.5 px title on a #FBFCFD card is unreadable, whatever the
     design intent. So the title ink is DERIVED from the pure hue instead of
     being a second colour — same hue and saturation, walked down in value only
     until it clears 4.5:1 against the card. Red, green and blue clear it almost
     unchanged; only yellow travels. See `autoInk()`.
     A caller may still pass `ink` explicitly and it wins.

     group = {
       title:"MECHANICAL", rule:"#E52521", ink:"#C8102E",   // ink optional
       total: 362,                       // printed in the corner, may be null
       totalLabel:"ASSETS",              // optional, defaults to ASSETS
       note:"tooltip for the total",     // optional
       items:[ {label:"PUMPS", value:52, nav:"nav('report/equipment')",
                sub:"52 assets"} , … ]   // sub is optional tooltip text
     }
     opts = { size:200, gap:8, pad:10, minLabel:34, minValue:18, font:"Consolas,monospace" }

   Depends on nothing. Offline. Tendrara Micro-LNG · Technical America.
   ═══════════════════════════════════════════════════════════════════════ */
(function () {
  "use strict";

  var MONO = "Consolas,monospace";

  function esc(s) {
    return String(s == null ? "" : s)
      .replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;");
  }

  /* ── squarified treemap ──────────────────────────────────────────────────
     Returns rectangles in the SAME ORDER as the items handed in, so the caller
     can zip them back to its own data without a lookup. */
  function squarify(items, W, H) {
    var out = [], total = 0, i;
    for (i = 0; i < items.length; i++) total += Math.max(0, +items[i].value || 0);
    if (!(total > 0) || !(W > 0) || !(H > 0)) return items.map(function (it) {
      return { item: it, x: 0, y: 0, w: 0, h: 0 };
    });

    // work on a copy sorted big → small: the algorithm needs descending input
    var list = items.map(function (it, k) {
      return { it: it, k: k, v: Math.max(0, +it.value || 0) };
    }).filter(function (r) { return r.v > 0; })
      .sort(function (a, b) { return b.v - a.v; });

    var scale = (W * H) / total;              // value → area
    var x = 0, y = 0, w = W, h = H;           // the rectangle still free
    var row = [], rowSum = 0;
    var placed = new Array(items.length);

    function shortest() { return Math.min(w, h); }

    // worst aspect ratio of `row` if it also had to hold `extra`
    function worst(extra) {
      var s = rowSum + (extra || 0);
      if (s <= 0) return Infinity;
      var side = shortest(), len = s * scale / side;   // thickness of the row
      var mx = 0, mn = Infinity, j, v;
      for (j = 0; j < row.length; j++) {
        v = row[j].v * scale / len;                    // the tile's other side
        if (v > mx) mx = v; if (v < mn) mn = v;
      }
      if (extra) {
        v = extra * scale / len;
        if (v > mx) mx = v; if (v < mn) mn = v;
      }
      if (!(mn > 0) || !(len > 0)) return Infinity;
      // Every tile in the row is `len` on one side. The least square tile is
      // either the smallest (len/mn) or the largest (mx/len); the worse of the
      // two IS the row's aspect ratio. Always ≥ 1.
      return Math.max(len / mn, mx / len);
    }

    function layRow() {
      if (!row.length) return;
      var side = shortest(), len = rowSum * scale / side, off = 0, j, t, sz;
      var horizontal = (w >= h);               // the row runs along the short side
      for (j = 0; j < row.length; j++) {
        t = row[j];
        sz = t.v * scale / len;
        placed[t.k] = horizontal
          ? { item: t.it, x: x, y: y + off, w: len, h: sz }
          : { item: t.it, x: x + off, y: y, w: sz, h: len };
        off += sz;
      }
      if (horizontal) { x += len; w -= len; } else { y += len; h -= len; }
      row = []; rowSum = 0;
    }

    for (i = 0; i < list.length; i++) {
      var v = list[i].v;
      if (row.length && worst(v) > worst(0)) layRow();
      row.push(list[i]); rowSum += v;
    }
    layRow();

    for (i = 0; i < items.length; i++)
      out.push(placed[i] || { item: items[i], x: 0, y: 0, w: 0, h: 0 });
    return out;
  }

  /* ── the palette ────────────────────────────────────────────────────────
     Four pure Mario hues, one per discipline. These are THE discipline code of
     the product — the same values the card band, the rules and the legends use.
     They are drawn at full saturation; nothing here is toned down. */
  var MARIO = {
    MECHANICAL:      "#E52521",   // red
    ELECTRICAL:      "#F4C320",   // gold
    INSTRUMENTATION: "#3FA540",   // green
    CONTROL:         "#2B6BD1"    // royal blue
  };
  var CARD = "#FBFCFD";           // the square's own background

  function rgbOf(hex) {
    var c = String(hex || "").replace("#", "");
    if (c.length === 3) c = c[0] + c[0] + c[1] + c[1] + c[2] + c[2];
    return [parseInt(c.slice(0, 2), 16) || 0,
            parseInt(c.slice(2, 4), 16) || 0,
            parseInt(c.slice(4, 6), 16) || 0];
  }
  // WCAG relative luminance — the eye is not linear and neither is sRGB.
  function lum(r, g, b) {
    function ch(v) { v /= 255; return v <= 0.03928 ? v / 12.92 : Math.pow((v + 0.055) / 1.055, 2.4); }
    return 0.2126 * ch(r) + 0.7152 * ch(g) + 0.0722 * ch(b);
  }
  function contrast(a, b) {
    var la = lum(a[0], a[1], a[2]), lb = lum(b[0], b[1], b[2]);
    return (Math.max(la, lb) + 0.05) / (Math.min(la, lb) + 0.05);
  }
  function hex2(n) { n = Math.max(0, Math.min(255, Math.round(n))); return (n < 16 ? "0" : "") + n.toString(16); }

  /* Title ink: the SAME hue, darkened in value only, just far enough to be
     legible on the card (4.5:1). Red / green / blue barely move; pure yellow
     has to travel, which is exactly why v0.1.0 swapped it for a different
     colour — this keeps the colour and moves the brightness instead. */
  function autoInk(hex) {
    var c = rgbOf(hex), bg = rgbOf(CARD);
    for (var k = 1; k >= 0.14; k -= 0.02) {
      var t = [c[0] * k, c[1] * k, c[2] * k];
      if (contrast(t, bg) >= 4.5) return "#" + hex2(t[0]) + hex2(t[1]) + hex2(t[2]);
    }
    return "#15171A";
  }

  /* ── colour ramp inside a discipline ────────────────────────────────────
     One hue per discipline (the rule colour), stepped in lightness by RANK so
     the biggest tile is the darkest. Rank, not value: with 30 fans against 2
     heaters a value ramp would collapse every small tile into the same wash.

     The ramp STARTS at the pure hue and walks DOWN into deeper shades of it: the
     biggest tile of every square is the discipline colour itself, undiluted, and
     the smaller tiles get darker rather than paler.

     [v0.3.0] It used to wash toward WHITE, which left the tail of a long square as
     a row of near-white rectangles — legible up close, weak on a projector, and
     nothing like the depth of the reference Mario sent. Multiplying down instead
     keeps every tile saturated at any rank, which is what lets a square read as one
     block of colour from the back of a room, and it puts white text on roughly two
     tiles in three.

     Direction note: the reference runs the other way — biggest tile darkest,
     smaller ones lighter. Kept as biggest = PURE because "the ramp starts at the
     pure hue" is a rule set earlier the same day, and the 3.4 px rule bar alone is
     too thin to carry the discipline colour. To flip it, swap the `f` line for
     `var f = (1 - DEEP) + DEEP * t;` — nothing else changes. */
  /* [v0.4.1] The four hues are used EXACTLY as Mario supplied them, and every label
     inside a square is WHITE. Both are his instruction, repeated, and neither is
     traded against the other:

       MECHANICAL #E52521 · ELECTRICAL #F4C320 · INSTRUMENTATION #3FA540 · CONTROL #2B6BD1

     The biggest tile of every square carries its pure hue, undiluted; the ramp only
     walks DOWN from there into deeper shades of the same colour, so nothing is ever
     lightened or muted.

     v0.4.0 briefly darkened the gold so white text would clear a contrast bound.
     That was wrong of me — it is the same mistake v0.1.0 made with #E0A800, and it
     changed a colour the owner had chosen. Reverted.

     For the record, so nobody re-discovers it and "fixes" it again: white on pure
     #F4C320 measures 1.66:1, which is below every WCAG bound. The number on the
     largest electrical tile is therefore the weakest text in the set. It matches the
     source treemap, which does the same thing at the same ratio. If a print or an
     audit ever forces the issue, the fix is a text shadow or a darker gold — not a
     silent change to the palette. */
  var DEEP = 0.58;                              // how far down the smallest tile goes

  function ramp(hex, k, n) {
    var c = rgbOf(hex);
    var t = n > 1 ? (k / (n - 1)) : 0;          // 0 = biggest, 1 = smallest
    var f = 1 - DEEP * t;                       // 1.00 pure hue  ->  0.42 deep shade
    return "rgb(" + Math.round(c[0] * f) + "," +
                    Math.round(c[1] * f) + "," +
                    Math.round(c[2] * f) + ")";
  }

  // White, always — every label inside a square, at every rank.
  function inkOn() { return "#FFFFFF"; }

  function square(group, opts) {
    opts = opts || {};
    var S = opts.size || 200, pad = opts.pad == null ? 10 : opts.pad;
    var head = 22, gap = opts.gap == null ? 2 : opts.gap;
    var minLabel = opts.minLabel || 34, minValue = opts.minValue || 18;
    var font = opts.font || MONO;
    var items = (group.items || []).filter(function (it) { return (+it.value || 0) > 0; });

    /* Colour resolution. The discipline title alone is enough: MECHANICAL,
       ELECTRICAL, INSTRUMENTATION and CONTROL each have exactly one pure hue
       and the library knows them, so a caller cannot accidentally ship a
       fifth red. An explicit `rule` still wins for anything off-register. */
    var rule = group.rule || MARIO[String(group.title || "").toUpperCase()] || "#2B6BD1";
    var ink  = group.ink  || autoInk(rule);

    var W = S - 2 * pad, H = S - 2 * pad - head;
    var rects = squarify(items, W, H);
    var n = rects.length;

    // rank for the ramp: by value, descending
    var order = rects.map(function (r, i) { return { i: i, v: +r.item.value || 0 }; })
      .sort(function (a, b) { return b.v - a.v; });
    var rank = {}; order.forEach(function (o, k) { rank[o.i] = k; });

    var body = rects.map(function (r, i) {
      var fill = ramp(rule, rank[i], n), tint = inkOn(fill);
      var x = pad + r.x + gap / 2, y = pad + head + r.y + gap / 2;
      var w = Math.max(0, r.w - gap), h = Math.max(0, r.h - gap);
      var it = r.item, txt = "";
      if (w >= minValue && h >= minValue) {
        var showLabel = (w >= minLabel && h >= 30);
        var fs = Math.max(7, Math.min(11, Math.round(Math.min(w, h) / 4.2)));
        txt += '<text x="' + (x + 5) + '" y="' + (y + fs + 3) + '" font-family="' + font +
               '" font-size="' + fs + '" font-weight="700" fill="' + tint + '">' + esc(it.value) + '</text>';
        if (showLabel) {
          var lfs = Math.max(5.5, Math.min(8, w / 9));
          var max = Math.floor((w - 10) / (lfs * 0.62));
          var lb = String(it.label || "");
          if (lb.length > max) lb = lb.slice(0, Math.max(1, max - 1)) + "…";
          txt += '<text x="' + (x + 5) + '" y="' + (y + h - 5) + '" font-family="' + font +
                 '" font-size="' + lfs.toFixed(1) + '" font-weight="700" letter-spacing=".04em" fill="' +
                 tint + '" opacity=".85">' + esc(lb) + '</text>';
        }
      }
      var tip = it.sub || (it.label + " · " + it.value);
      return '<g' + (it.nav ? ' style="cursor:pointer" onclick="' + esc(it.nav) + '"' : "") + '>' +
        '<title>' + esc(tip) + '</title>' +
        '<rect x="' + x + '" y="' + y + '" width="' + w + '" height="' + h +
        '" rx="2.5" fill="' + fill + '"/>' + txt + '</g>';
    }).join("");

    var totalTxt = group.total == null ? "" :
      '<text x="' + (S - pad) + '" y="' + (pad + 11) + '" text-anchor="end" font-family="' + font +
      '" font-size="13" font-weight="700" fill="#15171A">' + esc(group.total) + '</text>' +
      '<text x="' + (S - pad) + '" y="' + (pad + 19) + '" text-anchor="end" font-family="' + font +
      '" font-size="6.5" font-weight="700" letter-spacing=".1em" fill="#4A4F57">' +
      esc(group.totalLabel || "ASSETS") + '</text>';

    return '<svg viewBox="0 0 ' + S + ' ' + S + '" width="100%" style="display:block">' +
      '<rect x="0.6" y="0.6" width="' + (S - 1.2) + '" height="' + (S - 1.2) +
      '" rx="9" fill="#FBFCFD" stroke="#D8DDE2"/>' +
      '<rect x="0.6" y="0.6" width="' + (S - 1.2) + '" height="3.4" rx="1.7" fill="' + rule + '"/>' +
      '<text x="' + pad + '" y="' + (pad + 11) + '" font-family="' + font +
      '" font-size="8.5" font-weight="700" letter-spacing=".1em" fill="' + ink + '">' +
      esc(group.title) + '</text>' +
      (group.note ? '<title>' + esc(group.note) + '</title>' : "") +
      totalTxt + body + '</svg>';
  }

  function band(groups, opts) {
    opts = opts || {};
    var gap = opts.bandGap == null ? 8 : opts.bandGap;
    return '<div style="display:grid;grid-template-columns:repeat(' + (groups.length || 1) +
      ',minmax(0,1fr));gap:' + gap + 'px;align-items:start">' +
      groups.map(function (g) { return '<div>' + square(g, opts) + '</div>'; }).join("") +
      '</div>';
  }

  var API = { square: square, band: band, squarify: squarify,
              MARIO: MARIO, autoInk: autoInk, VERSION: "0.4.1" };
  if (typeof window !== "undefined") window.TamDisc = API;
  if (typeof module !== "undefined" && module.exports) module.exports = API;
})();


  function buildBand102(u,OBJ,CE,INSTR){
    var host=document.getElementById('objtiles'+u); if(!host) return;
    var S=UNITSTATS103[u]||{}, C=CLASS103[u]||{};

    function nav102(label){
      var t=TILE_NAV103[label]; if(!t) return "";
      return "DISC102['"+u+"']("+JSON.stringify(t[0])+","+JSON.stringify(t[1])+",null)";
    }
    function items(rows){
      return (rows||[]).filter(function(r){return r[2]>0;}).map(function(r){
        return {label:r[1].toUpperCase(), value:r[2], nav:nav102(r[1]), sub:r[1]+' · '+r[2]};
      });
    }
    /* A foot line carries what is NOT a registry asset, so it can never inflate a
       square that claims to partition the discipline. Manual valves live in
       plant_manual_valves (Stage-2); alarms have no class in the tree at all. Both
       counts are real and stay one click away. */
    function foot(txt, g){
      // single quotes inside the double-quoted attribute: JSON.stringify would emit
      // double quotes here and close the onclick early. The tiles are safe because
      // tam-disc escapes their nav string; this line is raw HTML.
      return '<div class="dsqfoot" onclick="DISC102[&#39;' + u + '&#39;](&#39;' + g + '&#39;,null,null)">'
        + txt + '</div>';
    }
    var mv   = (S.mv==null) ? '' : foot('+ '+S.mv+' MANUAL VALVES <i>· Stage-2 register, not registry assets</i>','mvalves');
    var alm  = OBJ.alarms.rows.length
             ? foot('+ '+OBJ.alarms.rows.length+' ALARMS <i>· alarm register, not registry assets</i>','alarms') : '';

    var groups=[
      ['MECHANICAL',     '#E52521','#C8102E', items(C.MECH), S.dMECH, mv ],
      ['ELECTRICAL',     '#F4C320','#8E7113', items(C.ELEC), S.dELEC, '' ],
      ['INSTRUMENTATION','#3FA540','#328433', items(C.INST), S.dINST, '' ],
      ['CONTROL',        '#2B6BD1','#2B6BD1', items(C.CTRL), S.dCTRL, alm]
    ];

    /* Equal columns, every discipline a square. The old row mixed squares with a
       card box and left a hole where a discipline had few classes — Mario,
       2026-07-29: "area fixed looks wrong". A square with one big tile and one thin
       one is the honest picture; the thin tile keeps its colour and its tooltip. */
    host.style.gridTemplateColumns='repeat(4,minmax(0,1fr))';
    host.innerHTML=groups.map(function(g){
      if(typeof TamDisc==='undefined' || !g[3].length) return '<div></div>';
      return '<div class="dsq">'
        + TamDisc.square({title:g[0], total:g[4], items:g[3]},{size:210})
        + g[5] + '</div>';
    }).join('');
  }
  (function(){
    // the document register is one list for both units (Unit 330 & 310)
    
    buildBand102('340',OBJ340,CE340,INSTR340);
  })();
  // area object modals (330 / 310)
  (function(){
    [['340',OBJ340,CE340]].forEach(function(cfg){
      var u=cfg[0], OBJ=cfg[1], CE=cfg[2];
      var modal=document.getElementById('objmodal'+u); if(!modal) return;
      var wrap=document.getElementById('objwrap'+u), ttl=document.getElementById('objtitle'+u);
      var CLSNAME102={PUMP:'Pumps',HX:'Heat exchangers',VESSEL:'Vessels & columns',FILTER:'Filters',FAN:'Fan banks',HEATER:'Heaters'};
      function open(g,f){
        if(g==='equipment' && f){
          var d0=OBJ.equipment, rows=d0.rows.filter(function(r){return eqClass102(r[0],r[1])===f;});
          ttl.textContent=CLSNAME102[f]+' · Unit '+u+' ('+rows.length+')';
          wrap.innerHTML=tbl102(d0.cols,rows)
            +'<div style="padding:12px 16px;font-size:11.5px;line-height:1.5;color:var(--ink-soft);border-top:1px dashed #C9CED4;">Subset of the '+d0.rows.length+' equipment records of the unit — same list, filtered by class.</div>';
          wrap.scrollTop=0; modal.classList.add('on'); return;
        }
        if(g==='ce'){ ttl.textContent=CE.title; wrap.innerHTML=ceHTML(CE); ceWire(wrap); modal.classList.add('on'); return; }
        if(g==='instruments'){
          // El modal de familias (imodal330/310) vive dentro de la diapositiva de
          // instrumentación, oculta (visibility:hidden) mientras se ve el área:
          // se abría pero no se veía. Pintamos el registro completo en ESTE modal.
          var INS = (u==='340')? INSTR340 : INSTR340;
          ttl.textContent='Instruments · all families · Unit '+u+' ('+INS.length+')';
          wrap.innerHTML=tbl102(['Tag','Service','Type','Range','Units','Signal','System','Equipment'], INS);
          wrap.scrollTop=0; modal.classList.add('on'); return;
        }
        var d=OBJ[g]; if(!d) return;
        ttl.textContent=d.title;
        var html=d.rows.length? tbl102(d.cols,d.rows) : '<div class="objempty">'+esc102(d.empty||'No items.')+'</div>';
        if(d.foot) html+='<div style="padding:12px 16px;font-size:11.5px;line-height:1.5;color:var(--ink-soft);border-top:1px dashed #C9CED4;">'+esc102(d.foot)+'</div>';
        wrap.innerHTML=html; wrap.scrollTop=0; modal.classList.add('on');
      }
      function openFamInline(u2,v){
        var INS=(u2==='340'?INSTR340:INSTR340).filter(function(r){return FAMOF[r[0]]===v;});
        ttl.textContent='Instruments · '+(FAMNAME[v]||v)+' · Unit '+u2+' ('+INS.length+')';
        wrap.innerHTML=tbl102(['Tag','Service','Type','Range','Units','Signal','System','Equipment'], INS);
        wrap.scrollTop=0; modal.classList.add('on');
      }
      function close(){ modal.classList.remove('on'); }
      [].slice.call(document.querySelectorAll('#objtiles'+u+' .dfact')).forEach(function(t){ t.onclick=function(){ if(t.dataset.fam) return openFamInline(u,t.dataset.fam); open(t.dataset.g, t.dataset.f); }; });
      /* Squares carry an inline nav string instead of a data attribute, so the
         same two entry points are published here. Cards and tiles land in the
         identical modal — the renderer changed, the navigation did not. */
      window.DISC102=window.DISC102||{};
      window.DISC102[u]=function(g,f,fam){ if(fam) return openFamInline(u,fam); open(g,f); };
      document.getElementById('objclose'+u).onclick=close;
      modal.addEventListener('click',function(e){ if(e.target===modal) close(); });
      document.addEventListener('keydown',function(e){ if(e.key==='Escape') close(); });
    });
  })();
  // instrument family modals + tile counts
  function openFam(u, v){
    var INSTR = u==='340'? INSTR340 : INSTR340;
    var modal=document.getElementById('imodal'+u); if(!modal) return;
    var wrap=document.getElementById('iwrap'+u), ttl=document.getElementById('ititle'+u);
    var rows = v? INSTR.filter(function(r){return FAMOF[r[0]]===v;}) : INSTR;
    ttl.textContent='Instruments · '+(v?FAMNAME[v]:('all families'))+' · Unit '+u+' ('+rows.length+')';
    wrap.innerHTML = tbl102(['Tag','Service','Type','Range','Units','Signal','System','Equipment'], rows);
    modal.classList.add('on');
  }
  (function(){
    [['340',INSTR340]].forEach(function(cfg){
      var u=cfg[0], INSTR=cfg[1];
      var cnt={}; INSTR.forEach(function(r){ var f=FAMOF[r[0]]; cnt[f]=(cnt[f]||0)+1; });
      [].slice.call(document.querySelectorAll('#itiles'+u+' .objtile')).forEach(function(t){
        var v=t.dataset.v, n=t.querySelector('[data-cnt]');
        if(n) n.textContent=cnt[v]||0;
        t.onclick=function(){ openFam(u,v); };
      });
      var modal=document.getElementById('imodal'+u); if(!modal) return;
      document.getElementById('iclose'+u).onclick=function(){ modal.classList.remove('on'); };
      modal.addEventListener('click',function(e){ if(e.target===modal) modal.classList.remove('on'); });
      document.addEventListener('keydown',function(e){ if(e.key==='Escape') modal.classList.remove('on'); });
    });
  })();
  // documents table (both units) — register copy + HEAD probe (HTTP only)
  (function(){
    var t=document.getElementById('docstbl102'); if(!t) return;
    t.innerHTML='<tr><th>Doc No</th><th>Title</th><th>Group</th><th>Rev</th><th>Open</th></tr>';
    var canProbe=/^https?:$/.test(location.protocol);
    DOCS103.forEach(function(d){
      var u=d.url?encodeURI(d.url):null;
      var a=function(txt){return '<a class="doclink" href="'+u+'" target="_blank" rel="noopener">'+txt+'</a>';};
      var tr=document.createElement('tr');
      tr.innerHTML='<td class="k" data-no>'+(u?a(esc102(d.no)):esc102(d.no))+'</td><td>'+esc102(d.ttl)+'</td>'+
        '<td class="doccat">'+esc102(d.grp)+'</td><td class="doccat">'+esc102(d.rev||'—')+'</td>'+
        '<td data-link>'+(u?a('open ↗'):'<span class="docstat off">pending</span>')+'</td>';
      t.appendChild(tr);
      if(!u || !canProbe) return;
      function fail(){ tr.querySelector('[data-link]').innerHTML='<span class="docstat off">file missing</span>';
                       tr.querySelector('[data-no]').textContent=d.no; }
      try{ fetch(u,{method:'HEAD'}).then(function(r){ if(!r.ok) fail(); }).catch(fail); }catch(e){ fail(); }
    });
  })();
  // area carousels — láminas fijas del markup (GA, heat map) y luego cualquier
  // captura 3D encontrada en /images (U330: 3D_300_NN y 3D_330_NN · U310: 3D_310_NN)
  (function(){
    [['c330',['3D_300','3D_330']],['c310',['3D_310']]].forEach(function(cfg){
      var carea=document.getElementById(cfg[0]); if(!carea) return;
      var bases=cfg[1], dots=document.getElementById(cfg[0]+'dots'), cap=document.getElementById(cfg[0]+'cap');
      function pad(n){return n<10?'0'+n:''+n;}
      var found=[];
      function probeBase(bi,done){
        if(bi>=bases.length){ done(); return; }
        var base=bases[bi];
        (function probe(i){
          if(i>12){ probeBase(bi+1,done); return; }
          var im=new Image();
          im.onload=function(){ found.push('/images/'+base+'_'+pad(i)+'.png'); probe(i+1); };
          im.onerror=function(){ probeBase(bi+1,done); };
          im.src='/images/'+base+'_'+pad(i)+'.png';
        })(1);
      }
      probeBase(0,function(){
        found.forEach(function(src,k){
          var div=document.createElement('div'); div.className='cimg';
          div.setAttribute('data-cap','3D capture '+(k+1));
          div.innerHTML='<img src="'+src+'" alt="3D capture '+(k+1)+'">';
          carea.insertBefore(div, dots);
        });
        var imgs=[].slice.call(carea.querySelectorAll('.cimg'));
        if(!imgs.length) return;
        dots.innerHTML='';
        imgs.forEach(function(im,k){
          im.classList.toggle('on',k===0);
          var b=document.createElement('b'); b.dataset.i=String(k);
          if(k===0) b.className='on';
          dots.appendChild(b);
        });
        var ds=[].slice.call(dots.querySelectorAll('b'));
        var caps=imgs.map(function(im,k){ return im.getAttribute('data-cap')||('View '+(k+1)); });
        if(cap) cap.textContent=caps[0]||'';
        if(imgs.length<2) return;
        var i=0, timer=null, iv=parseInt(carea.dataset.interval||'3400',10);
        function go(n){ i=(n+imgs.length)%imgs.length;
          imgs.forEach(function(im,k){im.classList.toggle('on',k===i);});
          ds.forEach(function(d,k){d.classList.toggle('on',k===i);});
          if(cap) cap.textContent=caps[i]||''; }
        function restart(){ clearInterval(timer); timer=setInterval(function(){go(i+1);},iv); }
        ds.forEach(function(d){ d.onclick=function(){ go(+d.dataset.i); restart(); }; });
        restart();
      });
    });
  })();
  // technological-object photo carousels — probe images/<base>_NN.png (same convention as module 101)
  (function(){
    var EQBASE={"V-331":"V-331","T-331":"T-331","V-332":"V-332","T-332":"T-332","P-332A/B":"P-332","E-311":"E-311"};
    [].slice.call(document.querySelectorAll('.eqdetail[data-eq]')).forEach(function(host){
      var tag=host.getAttribute('data-eq'), base=EQBASE[tag]||tag;
      var car=host.querySelector('[data-eqcar]'); if(!car) return;
      var timer=null;
      function pad(n){return n<10?'0'+n:''+n;}
      function probe(i,acc,done){
        if(i>20){ done(acc); return; }
        var im=new Image();
        im.onload=function(){ acc.push('/images/'+base+'_'+pad(i)+'.png'); probe(i+1,acc,done); };
        im.onerror=function(){ done(acc); };
        im.src='/images/'+base+'_'+pad(i)+'.png';
      }
      function build(list){
        clearInterval(timer);
        if(!list.length){ car.innerHTML='<div style="font-family:Consolas,monospace;font-size:10.5px;color:#B26A00;text-align:center;padding:18px;line-height:1.7;">No photos yet.<br>Drop '+base+'_01.png, _02… into images/ and they appear here on reload.</div>'; return; }
        if(list.length===1){ car.innerHTML='<img class="eqc-solo" src="'+list[0]+'" alt="'+tag+'">'; return; }
        car.innerHTML=list.map(function(s,k){return '<img class="eqc-img'+(k===0?' on':'')+'" src="'+s+'" alt="'+tag+'">';}).join('')
          +'<div class="eqc-count">1/'+list.length+'</div>'
          +'<div class="eqc-dots">'+list.map(function(s,k){return '<b class="'+(k===0?'on':'')+'" data-i="'+k+'"></b>';}).join('')+'</div>';
        var imgs=[].slice.call(car.querySelectorAll('.eqc-img'));
        var dots=[].slice.call(car.querySelectorAll('.eqc-dots b'));
        var cnt=car.querySelector('.eqc-count'), ci=0;
        function go(n){ ci=(n+imgs.length)%imgs.length;
          imgs.forEach(function(im,k){im.classList.toggle('on',k===ci);});
          dots.forEach(function(d,k){d.classList.toggle('on',k===ci);});
          cnt.textContent=(ci+1)+'/'+imgs.length; }
        function restart(){ clearInterval(timer); timer=setInterval(function(){go(ci+1);},3800); }
        dots.forEach(function(d){ d.onclick=function(ev){ ev.stopPropagation(); go(+d.dataset.i); restart(); }; });
        restart();
      }
      var im0=new Image();
      im0.onload=function(){ probe(1,['/images/'+base+'_00.png'],build); };
      im0.onerror=function(){ probe(1,[],build); };
      im0.src='/images/'+base+'_00.png';
    });
  })();
</script>
<script>
  // Botones de plano — misma disciplina que las dos tablas de documentos: si el PDF
  // no está en el sitio, el botón se apaga y lo dice, no se queda con un link muerto.
  // Sólo se sondea servido por HTTP; en file:// CORS lo bloquea y sería un falso rojo.
  (function(){
    if(!/^https?:$/.test(location.protocol)) return;
    [].slice.call(document.querySelectorAll('a.docbtn')).forEach(function(a){
      var u=a.getAttribute('href'); if(!u) return;
      function fail(){ a.classList.add('gone'); a.removeAttribute('target'); }
      try{ fetch(encodeURI(u),{method:'HEAD'}).then(function(r){ if(!r.ok) fail(); }).catch(fail); }
      catch(e){ fail(); }
    });
  })();
</script>
<div class="lightbox" id="lightbox"><button class="lbclose" aria-label="close">✕</button><img id="lbimg" src="" alt=""><div class="lbcap" id="lbcap"></div></div>
<script>
  // global image lightbox — click any image in the deck to enlarge
  (function(){
    var lb=document.getElementById('lightbox'); if(!lb) return;
    var lbimg=document.getElementById('lbimg'), lbcap=document.getElementById('lbcap');
    // data-zoom-src lets a slide show a tight crop and still open the full
    // sheet on click — used by slide 11, where the cropped R1 drawing is on the
    // slide and the complete manual page (title block + fluid list) is the zoom.
    function show(im){ lbimg.src=im.dataset.zoomSrc||im.currentSrc||im.src; lbimg.alt=im.alt||''; lbcap.textContent=im.dataset.zoomCap||im.alt||''; lb.classList.add('on'); }
    function hide(){ lb.classList.remove('on'); lbimg.removeAttribute('src'); }
    var stage=document.getElementById('stage')||document.querySelector('.stage');
    if(stage){ stage.addEventListener('click',function(e){
      var im=e.target;
      if(im && im.tagName==='IMG'){ e.preventDefault(); e.stopPropagation(); show(im); }
    }); }
    lb.addEventListener('click',hide);
    document.addEventListener('keydown',function(e){ if(e.key==='Escape') hide(); });
  })();
</script>
<script>
  /* ═══ LOC340 · ONE geometry per circuit, reused by every slide that shows it ═══
     Ten sheets. A slide never pastes a sheet; it declares
       <div class="loc" data-circuit="cycle" data-hi="E-342">
     and the CSS dims every other [data-eq] group. Never edit geometry to
     highlight something. Annotation layers add TEXT ONLY and grow the viewBox,
     so the overview and the equipment slides are provably the same drawing.
     Source: tools/gen_sheets340.py -- edit there, then rebuild. */
