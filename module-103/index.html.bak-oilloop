          <text x="586.3999999999999" y="65" text-anchor="middle" font-family="Segoe UI,Arial" font-size="13.5" font-weight="700" fill="#fff">UNIT 340</text>
          <text x="586.3999999999999" y="79" text-anchor="middle" font-family="Segoe UI,Arial" font-size="7.4" fill="#ffd9df">REFRIGERATION</text><text x="586.3999999999999" y="93" text-anchor="middle" font-family="Consolas,monospace" font-size="7.6" font-weight="700" fill="#fff" opacity=".92">&#9660; YOU ARE HERE</text></g><g >
          <rect x="664.3999999999999" y="42" width="108" height="58" rx="6" fill="#fff" stroke="#D6DAE0" stroke-width="1.2"/>
          <text x="718.3999999999999" y="67" text-anchor="middle" font-family="Segoe UI,Arial" font-size="13.5" font-weight="700" fill="#15171A">UNIT 370</text>
          <text x="718.3999999999999" y="82" text-anchor="middle" font-family="Segoe UI,Arial" font-size="7.4" fill="#4A4F57">VAPORIZER</text></g><g >
          <rect x="143.6" y="392" width="108" height="58" rx="6" fill="#fff" stroke="#D6DAE0" stroke-width="1.2"/>
          <text x="197.6" y="417" text-anchor="middle" font-family="Segoe UI,Arial" font-size="13.5" font-weight="700" fill="#15171A">UNIT 410</text>
          <text x="197.6" y="432" text-anchor="middle" font-family="Segoe UI,Arial" font-size="7.4" fill="#4A4F57">HOT OIL PACKAGE</text></g><g >
          <rect x="294.79999999999995" y="392" width="108" height="58" rx="6" fill="#fff" stroke="#D6DAE0" stroke-width="1.2"/>
          <text x="348.79999999999995" y="417" text-anchor="middle" font-family="Segoe UI,Arial" font-size="13.5" font-weight="700" fill="#15171A">UNIT 530</text>
