  var FAMOF={"PT-3401": "P", "LT-3401": "L", "PG-3402": "P", "PCV-3402": "P", "SG-3401A": "L", "SG-3401B": "L", "PT-3411.1": "P", "PT-3412.1": "P", "PT-3413.1": "P", "TT-3412.1": "T", "TT-3417.1": "T", "TT-3418.1": "T", "TT-3419.1": "T", "ZT-3411.1": "Z", "LSL-3417.1": "L", "LG-3411.1": "L", "PG-3415.1": "P", "PG-3417.1": "P", "PDG-3414.1": "P", "PDG-3415.1": "P", "PDCV-3417.1": "P", "SG-3415.1": "L", "SG-3417A.1": "L", "SG-3417B.1": "L", "SG-3417C.1": "L", "HS-3411.1-LR": "H", "HS-3411.1-ST": "H", "HS-3411.1-TP": "H", "HS-3411.1-LSD": "H", "XL-3411.1-RU": "H", "XL-3411.1-RE": "H", "XL-3411.1-AL": "H", "ST341-1": "T", "PT-3411.2": "P", "PT-3412.2": "P", "PT-3413.2": "P", "TT-3412.2": "T", "TT-3417.2": "T", "TT-3418.2": "T", "TT-3419.2": "T", "ZT-3411.2": "Z", "LSL-3417.2": "L", "LG-3411.2": "L", "PG-3415.2": "P", "PG-3417.2": "P", "PDG-3414.2": "P", "PDG-3415.2": "P", "PDCV-3417.2": "P", "SG-3415.2": "L", "SG-3417A.2": "L", "SG-3417B.2": "L", "SG-3417C.2": "L", "HS-3411.2-LR": "H", "HS-3411.2-ST": "H", "HS-3411.2-TP": "H", "HS-3411.2-LSD": "H", "XL-3411.2-RU": "H", "XL-3411.2-RE": "H", "XL-3411.2-AL": "H", "ST341-2": "T", "PT-3411.3": "P", "PT-3412.3": "P", "PT-3413.3": "P", "TT-3412.3": "T", "TT-3417.3": "T", "TT-3418.3": "T", "TT-3419.3": "T", "ZT-3411.3": "Z", "LSL-3417.3": "L", "LG-3411.3": "L", "PG-3415.3": "P", "PG-3417.3": "P", "PDG-3414.3": "P", "PDG-3415.3": "P", "PDCV-3417.3": "P", "SG-3415.3": "L", "SG-3417A.3": "L", "SG-3417B.3": "L", "SG-3417C.3": "L", "HS-3411.3-LR": "H", "HS-3411.3-ST": "H", "HS-3411.3-TP": "H", "HS-3411.3-LSD": "H", "XL-3411.3-RU": "H", "XL-3411.3-RE": "H", "XL-3411.3-AL": "H", "ST341-3": "T", "PT-3411.4": "P", "PT-3412.4": "P", "PT-3413.4": "P", "TT-3412.4": "T", "TT-3417.4": "T", "TT-3418.4": "T", "TT-3419.4": "T", "ZT-3411.4": "Z", "LSL-3417.4": "L", "LG-3411.4": "L", "PG-3415.4": "P", "PG-3417.4": "P", "PDG-3414.4": "P", "PDG-3415.4": "P", "PDCV-3417.4": "P", "SG-3415.4": "L", "SG-3417A.4": "L", "SG-3417B.4": "L", "SG-3417C.4": "